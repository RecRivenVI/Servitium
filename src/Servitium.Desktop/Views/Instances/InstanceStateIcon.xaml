<UserControl
    x:Class="Servitium.Desktop.Views.Instances.InstanceStateIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    AutomationProperties.Name="{x:Bind Label}">
    <Grid>
        <FontIcon
            Glyph=""
            Foreground="{ThemeResource SystemFillColorSuccessBrush}"
            Visibility="{x:Bind IsRunning}" />
        <FontIcon
            Glyph="&#xEA3B;"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{x:Bind IsStopped}" />
        <FontIcon
            Glyph=""
            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
            Visibility="{x:Bind IsCritical}" />
        <FontIcon
            Glyph=""
            Foreground="{ThemeResource TextFillColorDisabledBrush}"
            Visibility="{x:Bind IsOffline}" />
        <FontIcon
            Glyph=""
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Visibility="{x:Bind IsPending}" />
    </Grid>
</UserControl>
