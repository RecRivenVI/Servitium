<Page
    x:Class="Servitium.Desktop.Views.Instances.InstanceWorkspacePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Servitium.Desktop.Views.Instances"
    xmlns:models="using:Servitium.Desktop.ViewModels.Instances"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch">
    <Page.Resources>
        <CollectionViewSource
            x:Name="GroupedInstances"
            Source="{x:Bind ViewModel.Groups, Mode=OneWay}"
            IsSourceGrouped="True"
            ItemsPath="Items" />
    </Page.Resources>
    <Grid
        x:Name="WorkspaceRoot"
        SizeChanged="OnWorkspaceSizeChanged"
        Padding="{ThemeResource TextControlThemePadding}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <StackPanel
            Spacing="{ThemeResource SelectorBarItemSpacing}">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="{x:Bind ViewModel.Severity, Mode=OneWay}"
                IsClosable="True" />
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>
        <SplitView
            x:Name="WorkspaceSplit"
            Grid.Row="1"
            DisplayMode="Inline"
            IsPaneOpen="True"
            PaneBackground="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <SplitView.Pane>
                <Grid
                    Padding="{ThemeResource TextControlThemePadding}"
                    RowSpacing="{ThemeResource SelectorBarItemSpacing}">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="*" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{ThemeResource SelectorBarItemSpacing}">
                        <TextBlock
                            Text="{x:Bind ViewModel.Text('instance.list.title')}"
                            Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Count, Mode=OneWay}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock
                        Grid.Row="1"
                        Text="{x:Bind ViewModel.Summary, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <TextBox
                        Grid.Row="2"
                        PlaceholderText="{x:Bind ViewModel.Text('desktop.filter-instances')}"
                        Text="{x:Bind ViewModel.Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.AutomationId="instances:filter" />
                    <ComboBox
                        Grid.Row="3"
                        SelectedIndex="{x:Bind ViewModel.StatusFilter, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind ViewModel.Text('field.status')}">
                        <ComboBoxItem
                            Content="{x:Bind ViewModel.Text('desktop.filter-all')}" />
                        <ComboBoxItem
                            Content="{x:Bind ViewModel.Text('state.running')}" />
                        <ComboBoxItem
                            Content="{x:Bind ViewModel.Text('desktop.instance-state-stopped')}" />
                        <ComboBoxItem
                            Content="{x:Bind ViewModel.Text('desktop.filter-attention')}" />
                    </ComboBox>
                    <Grid
                        Grid.Row="4">
                        <ListView
                            x:Name="InstanceList"
                            ItemsSource="{x:Bind GroupedInstances.View, Mode=OneWay}"
                            SelectionMode="Extended"
                            SelectionChanged="OnInstanceSelectionChanged"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="instances:list">
                            <ListView.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate
                                            x:DataType="models:InstanceNodeGroup">
                                            <StackPanel
                                                x:Name="NodeHeaderRoot">
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    Visibility="{x:Bind IsOnline}" />
                                                <TextBlock
                                                    Text="{Binding Name}"
                                                    Style="{ThemeResource BodyStrongTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorDisabledBrush}"
                                                    Visibility="{x:Bind IsOffline}" />
                                                <TextBlock
                                                    Text="{Binding Detail}"
                                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListView.GroupStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate
                                    x:DataType="models:InstanceRow">
                                    <Grid
                                        ColumnSpacing="{ThemeResource SelectorBarItemSpacing}"
                                        Padding="{ThemeResource TextControlThemePadding}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition
                                                Width="Auto" />
                                            <ColumnDefinition
                                                Width="*" />
                                            <ColumnDefinition
                                                Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <local:InstanceStateIcon
                                            State="{x:Bind State}"
                                            Label="{x:Bind Status}" />
                                        <StackPanel
                                            Grid.Column="1">
                                            <TextBlock
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind Version}"
                                                Style="{ThemeResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{Binding Detail}"
                                            VerticalAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <TextBlock
                            Text="{x:Bind ViewModel.Text('desktop.no-instances-next')}"
                            Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                            TextWrapping="Wrap"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel
                        Grid.Row="5"
                        Orientation="Horizontal"
                        Spacing="{ThemeResource SelectorBarItemSpacing}">
                        <Button
                            Content="{x:Bind ViewModel.Text('instance.create.title')}"
                            Click="OnCreateClick"
                            Visibility="{x:Bind ViewModel.IsAdministrator}"
                            AutomationProperties.AutomationId="instances:create" />
                        <Button
                            Content="{x:Bind ViewModel.Text('action.refresh')}"
                            Click="OnRefreshClick"
                            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </SplitView.Pane>
            <Grid
                Padding="{ThemeResource TextControlThemePadding}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Name="InstancesPaneButton"
                        Content="{x:Bind ViewModel.Text('instance.list.title')}"
                        Visibility="Collapsed"
                        Click="OnShowInstancesClick" />
                    <TextBlock
                        Grid.Column="1"
                        ToolTipService.ToolTip="{x:Bind ViewModel.Name, Mode=OneWay}"
                        Text="{x:Bind ViewModel.Name, Mode=OneWay}"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        TextTrimming="CharacterEllipsis" />
                    <local:InstanceStateIcon
                        Grid.Column="2"
                        State="{x:Bind ViewModel.Selected.State, Mode=OneWay}"
                        Label="{x:Bind ViewModel.Status, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="3"
                        Text="{x:Bind ViewModel.Status, Mode=OneWay}"
                        VerticalAlignment="Center" />
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <CommandBar
                    Grid.Row="2"
                    DefaultLabelPosition="Right"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <AppBarButton
                        Label="{x:Bind ViewModel.Text('action.start')}"
                        Icon="Play"
                        Command="{x:Bind ViewModel.StartCommand}"
                        AutomationProperties.AutomationId="instance:start" />
                    <AppBarButton
                        Label="{x:Bind ViewModel.Text('action.stop')}"
                        Icon="Stop"
                        Command="{x:Bind ViewModel.StopCommand}"
                        AutomationProperties.AutomationId="instance:stop" />
                    <AppBarButton
                        Label="{x:Bind ViewModel.Text('action.restart')}"
                        Icon="Refresh"
                        Command="{x:Bind ViewModel.RestartCommand}" />
                    <AppBarButton
                        Label="{x:Bind ViewModel.Text('desktop.instance-update-title')}"
                        Icon="Download"
                        Command="{x:Bind ViewModel.UpdateCommand}"
                        Visibility="{x:Bind ViewModel.CanUpdate, Mode=OneWay}" />
                    <CommandBar.SecondaryCommands>
                        <AppBarButton
                            Label="{x:Bind ViewModel.Text('desktop.accept-eula')}"
                            Command="{x:Bind ViewModel.AcceptEulaCommand}" />
                        <AppBarButton
                            Label="{x:Bind ViewModel.Text('desktop.force-stop-title')}"
                            Command="{x:Bind ViewModel.ForceStopCommand}" />
                        <AppBarButton
                            Label="{x:Bind ViewModel.Text('action.export-log')}"
                            Click="OnExportLogClick"
                            IsEnabled="{x:Bind ViewModel.CanExportLog, Mode=OneWay}" />
                        <AppBarButton
                            Label="{x:Bind ViewModel.Text('desktop.open-working-directory')}"
                            Click="OnWorkingDirectoryClick"
                            IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}" />
                    </CommandBar.SecondaryCommands>
                </CommandBar>
                <InfoBar
                    Grid.Row="3"
                    IsOpen="{x:Bind ViewModel.HasStateMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.StateMessage, Mode=OneWay}"
                    Severity="Warning"
                    IsClosable="False" />
                <ScrollViewer
                    Grid.Row="4"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    IsEnabled="{x:Bind ViewModel.HasSelection, Mode=OneWay}">
                    <SelectorBar
                        x:Name="WorkspaceTabs"
                        SelectionChanged="OnTabSelectionChanged"
                        AutomationProperties.AutomationId="instance:tabs">
                        <SelectorBarItem
                            Text="{x:Bind ViewModel.Text('desktop.tab-console')}"
                            Tag="PG-012"
                            IsSelected="True" />
                        <SelectorBarItem
                            Text="{x:Bind ViewModel.Text('desktop.tab-files')}"
                            Tag="PG-013" />
                        <SelectorBarItem
                            Text="{x:Bind ViewModel.Text('desktop.tab-configuration')}"
                            Tag="PG-014" />
                        <SelectorBarItem
                            Text="{x:Bind ViewModel.Text('desktop.tab-mods')}"
                            Tag="PG-016" />
                        <SelectorBarItem
                            Text="{x:Bind ViewModel.Text('desktop.tab-schedules')}"
                            Tag="PG-017" />
                        <SelectorBarItem
                            Text="{x:Bind ViewModel.Text('desktop.tab-settings')}"
                            Tag="PG-018" />
                    </SelectorBar>
                </ScrollViewer>
                <ContentPresenter
                    x:Name="TabHost"
                    Grid.Row="5"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Grid>
        </SplitView>
    </Grid>
</Page>
