<ContentDialog
    x:Class="Servitium.Desktop.Views.Instances.InstanceCreationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Servitium.Desktop.ViewModels.Instances"
    Title="{x:Bind ViewModel.Text('instance.create.title')}"
    CloseButtonText="{x:Bind ViewModel.Text('common.cancel')}">
    <Grid
        RowSpacing="{ThemeResource SelectorBarItemSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock
            Text="{x:Bind ViewModel.StepTitle, Mode=OneWay}"
            Style="{ThemeResource SubtitleTextBlockStyle}" />
        <StackPanel
            Grid.Row="1">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="{x:Bind ViewModel.Severity, Mode=OneWay}" />
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled"
            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}">
            <StackPanel
                Spacing="{ThemeResource SelectorBarItemSpacing}">
                <StackPanel
                    Visibility="{x:Bind ViewModel.IsSourceStep, Mode=OneWay}"
                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                    <ComboBox
                        Header="{x:Bind ViewModel.Text('desktop.create-source')}"
                        SelectedIndex="{x:Bind ViewModel.SourceMode, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem
                            Content="{x:Bind ViewModel.Text('desktop.create-empty')}" />
                        <ComboBoxItem
                            Content="{x:Bind ViewModel.Text('instance.action.import-server-archive')}" />
                        <ComboBoxItem
                            Content="{x:Bind ViewModel.Text('instance.action.attach-directory')}" />
                    </ComboBox>
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.create-source-help')}"
                        TextWrapping="Wrap" />
                    <StackPanel
                        Visibility="{x:Bind ViewModel.IsArchive, Mode=OneWay}">
                        <TextBox
                            Text="{x:Bind ViewModel.ArchivePath, Mode=OneWay}"
                            Header="{x:Bind ViewModel.Text('desktop.archive-file')}"
                            IsReadOnly="True" />
                        <Button
                            Content="{x:Bind ViewModel.Text('desktop.choose-archive')}"
                            Click="OnChooseArchiveClick" />
                    </StackPanel>
                    <TextBox
                        Header="{x:Bind ViewModel.Text('field.working-directory')}"
                        Text="{x:Bind ViewModel.AbsolutePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ViewModel.IsAttach, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Visibility="{x:Bind ViewModel.IsBasicStep, Mode=OneWay}"
                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                    <TextBox
                        Header="{x:Bind ViewModel.Text('field.name')}"
                        Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.AutomationId="creation:name" />
                    <ComboBox
                        Header="{x:Bind ViewModel.Text('field.node')}"
                        ItemsSource="{x:Bind ViewModel.Nodes, Mode=OneWay}"
                        DisplayMemberPath="Name"
                        SelectedItem="{x:Bind ViewModel.SelectedNode, Mode=TwoWay}"
                        SelectionChanged="OnNodeChanged"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="creation:node" />
                    <ComboBox
                        Header="{x:Bind ViewModel.Text('field.java-runtime')}"
                        ItemsSource="{x:Bind ViewModel.Launch.Runtimes, Mode=OneWay}"
                        DisplayMemberPath="ExecutablePath"
                        SelectedItem="{x:Bind ViewModel.Launch.SelectedJava, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="creation:java" />
                    <NumberBox
                        Header="{x:Bind ViewModel.Text('desktop.minimum-memory')}"
                        Value="{x:Bind ViewModel.Launch.MinimumHeap, Mode=TwoWay}"
                        SpinButtonPlacementMode="Inline" />
                    <NumberBox
                        Header="{x:Bind ViewModel.Text('desktop.maximum-memory')}"
                        Value="{x:Bind ViewModel.Launch.MaximumHeap, Mode=TwoWay}"
                        SpinButtonPlacementMode="Inline" />
                    <TextBox
                        Header="{x:Bind ViewModel.Text('desktop.launch-target')}"
                        Text="{x:Bind ViewModel.Launch.Target, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Expander
                        Header="{x:Bind ViewModel.Text('desktop.more-launch-options')}"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="creation:more-launch">
                        <StackPanel
                            Spacing="{ThemeResource SelectorBarItemSpacing}">
                            <ComboBox
                                Header="{x:Bind ViewModel.Text('desktop.launch-kind')}"
                                SelectedIndex="{x:Bind ViewModel.Launch.TargetKind, Mode=TwoWay}">
                                <ComboBoxItem
                                    Content="{x:Bind ViewModel.Text('desktop.launch-jar')}" />
                                <ComboBoxItem
                                    Content="{x:Bind ViewModel.Text('desktop.launch-argfile')}" />
                            </ComboBox>
                            <TextBox
                                Header="{x:Bind ViewModel.Text('desktop.jvm-arguments')}"
                                Text="{x:Bind ViewModel.Launch.JvmArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" />
                            <TextBox
                                Header="{x:Bind ViewModel.Text('desktop.server-arguments')}"
                                Text="{x:Bind ViewModel.Launch.ServerArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" />
                            <CheckBox
                                Content="{x:Bind ViewModel.Text('desktop.launch-advanced')}"
                                IsChecked="{x:Bind ViewModel.Launch.AdvancedMode, Mode=TwoWay}"
                                IsEnabled="{x:Bind ViewModel.Launch.CanChangeAdvanced, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Text('desktop.launch-advanced-help')}"
                                TextWrapping="Wrap" />
                            <TextBox
                                Header="{x:Bind ViewModel.Text('desktop.launch-advanced-arguments')}"
                                Text="{x:Bind ViewModel.Launch.AdvancedArguments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True"
                                Visibility="{x:Bind ViewModel.Launch.AdvancedMode, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Text('field.environment-variables')}"
                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <ItemsControl
                                ItemsSource="{x:Bind ViewModel.Launch.EnvironmentVariables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate
                                        x:DataType="vm:LaunchEnvironmentVariable">
                                        <StackPanel
                                            Spacing="{ThemeResource SelectorBarItemSpacing}">
                                            <TextBox
                                                Header="{x:Bind NameLabel}"
                                                Text="{x:Bind Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.AutomationId="launch:env-name" />
                                            <TextBox
                                                Header="{x:Bind ValueLabel}"
                                                Text="{x:Bind Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AcceptsReturn="True"
                                                AutomationProperties.AutomationId="launch:env-value" />
                                            <Button
                                                Content="{x:Bind RemoveLabel}"
                                                Click="OnRemoveEnvironment" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button
                                Content="{x:Bind ViewModel.Text('desktop.launch-add-environment')}"
                                Command="{x:Bind ViewModel.Launch.AddEnvironmentCommand}"
                                AutomationProperties.AutomationId="creation:add-environment" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Text('desktop.launch-environment-help')}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Text('desktop.launch-preview')}"
                                Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Launch.Preview, Mode=OneWay}"
                                TextWrapping="Wrap"
                                IsTextSelectionEnabled="True" />
                            <TextBox
                                Header="{x:Bind ViewModel.Text('field.stop-command')}"
                                Text="{x:Bind ViewModel.StopCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <NumberBox
                                Header="{x:Bind ViewModel.Text('desktop.stop-timeout')}"
                                Value="{x:Bind ViewModel.StopTimeout, Mode=TwoWay}" />
                            <TextBox
                                Header="{x:Bind ViewModel.Text('field.tags')}"
                                Text="{x:Bind ViewModel.Tags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox
                                Header="{x:Bind ViewModel.Text('field.notes')}"
                                Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AcceptsReturn="True" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
                <StackPanel
                    Visibility="{x:Bind ViewModel.IsReviewStep, Mode=OneWay}"
                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                    <TextBlock
                        Text="{x:Bind ViewModel.Review, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.create-review-help')}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasValidation, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Validation, Mode=OneWay}"
                    Severity="Informational"
                    IsClosable="False" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="3"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Spacing="{ThemeResource SelectorBarItemSpacing}">
            <Button
                Content="{x:Bind ViewModel.Text('desktop.previous-step')}"
                Command="{x:Bind ViewModel.BackCommand}" />
            <Button
                Content="{x:Bind ViewModel.Text('desktop.next-step')}"
                Command="{x:Bind ViewModel.NextCommand}"
                Visibility="{x:Bind ViewModel.IsBeforeReview, Mode=OneWay}"
                AutomationProperties.AutomationId="creation:next" />
            <Button
                Content="{x:Bind ViewModel.Text('action.create')}"
                Command="{x:Bind ViewModel.CreateCommand}"
                Visibility="{x:Bind ViewModel.IsReviewStep, Mode=OneWay}"
                Style="{ThemeResource AccentButtonStyle}"
                AutomationProperties.AutomationId="creation:submit" />
        </StackPanel>
    </Grid>
</ContentDialog>
