<UserControl
    x:Class="Servitium.Desktop.Views.Instances.InstanceSchedulesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Servitium.Desktop.ViewModels.Instances"
    AutomationProperties.Name="{x:Bind ViewModel.Text('desktop.tab-schedules')}">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control"
            Invoked="OnSaveInvoked" />
    </UserControl.KeyboardAccelerators>
    <Grid
        x:Name="LayoutRoot"
        SizeChanged="OnLayoutSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="{x:Bind ViewModel.Severity, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsOffline, Mode=OneWay}"
                Message="{x:Bind ViewModel.Text('desktop.instance-offline-next')}"
                Severity="Warning"
                IsClosable="False" />
        </StackPanel>
        <CommandBar
            Grid.Row="1"
            HorizontalAlignment="Left"
            DefaultLabelPosition="Right"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <AppBarButton
                Label="{x:Bind ViewModel.Text('desktop.schedule-new')}"
                Icon="Add"
                Command="{x:Bind ViewModel.NewCommand}"
                AutomationProperties.AutomationId="schedules:new" />
            <AppBarButton
                Label="{x:Bind ViewModel.Text('action.refresh')}"
                Icon="Refresh"
                Command="{x:Bind ViewModel.RefreshCommand}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.delete')}"
                    Icon="Delete"
                    Command="{x:Bind ViewModel.DeleteCommand}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <SplitView
            Grid.Row="2"
            x:Name="EditorSplit"
            PanePlacement="Right"
            DisplayMode="Inline"
            IsPaneOpen="{x:Bind ViewModel.IsEditorOpen, Mode=OneWay}"
            PaneClosing="OnPaneClosing"
            PaneOpened="OnPaneOpened"
            PaneBackground="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <SplitView.Pane>
                <Grid
                    Padding="{ThemeResource TextControlThemePadding}"
                    RowSpacing="{ThemeResource SelectorBarItemSpacing}">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="*" />
                        <RowDefinition
                            Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ScrollViewer
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled">
                        <StackPanel
                            Spacing="{ThemeResource SelectorBarItemSpacing}">
                            <InfoBar
                                IsOpen="{x:Bind ViewModel.HasValidation, Mode=OneWay}"
                                Severity="Warning"
                                Message="{x:Bind ViewModel.Validation, Mode=OneWay}"
                                IsClosable="False" />
                            <ContentControl
                                IsEnabled="{x:Bind ViewModel.CanRead, Mode=OneWay}"
                                HorizontalContentAlignment="Stretch">
                                <StackPanel
                                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                                    <TextBox
                                        x:Name="TaskNameInput"
                                        Header="{x:Bind ViewModel.Text('field.name')}"
                                        Text="{x:Bind ViewModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.AutomationId="schedules:name" />
                                    <ComboBox
                                        Header="{x:Bind ViewModel.Text('field.trigger')}"
                                        SelectedIndex="{x:Bind ViewModel.Trigger.KindIndex, Mode=TwoWay}">
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.schedule-trigger-interval')}" />
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.schedule-trigger-calendar')}" />
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.schedule-trigger-specified')}" />
                                    </ComboBox>
                                    <TextBox
                                        Header="{x:Bind ViewModel.Text('desktop.schedule-interval-seconds')}"
                                        Text="{x:Bind ViewModel.Trigger.IntervalSeconds, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Visibility="{x:Bind ViewModel.Trigger.IsInterval, Mode=OneWay}" />
                                    <StackPanel
                                        Visibility="{x:Bind ViewModel.Trigger.IsCalendar, Mode=OneWay}">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.Text('desktop.schedule-node-time')}"
                                            TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition
                                                    Width="*" />
                                                <ColumnDefinition
                                                    Width="*" />
                                                <ColumnDefinition
                                                    Width="*" />
                                                <ColumnDefinition
                                                    Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition
                                                    Height="Auto" />
                                                <RowDefinition
                                                    Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox
                                                Content="{x:Bind ViewModel.Text('desktop.day-0')}"
                                                IsChecked="{x:Bind ViewModel.Trigger.Sunday, Mode=TwoWay}" />
                                            <CheckBox
                                                Grid.Column="1"
                                                Content="{x:Bind ViewModel.Text('desktop.day-1')}"
                                                IsChecked="{x:Bind ViewModel.Trigger.Monday, Mode=TwoWay}" />
                                            <CheckBox
                                                Grid.Column="2"
                                                Content="{x:Bind ViewModel.Text('desktop.day-2')}"
                                                IsChecked="{x:Bind ViewModel.Trigger.Tuesday, Mode=TwoWay}" />
                                            <CheckBox
                                                Grid.Column="3"
                                                Content="{x:Bind ViewModel.Text('desktop.day-3')}"
                                                IsChecked="{x:Bind ViewModel.Trigger.Wednesday, Mode=TwoWay}" />
                                            <CheckBox
                                                Grid.Row="1"
                                                Content="{x:Bind ViewModel.Text('desktop.day-4')}"
                                                IsChecked="{x:Bind ViewModel.Trigger.Thursday, Mode=TwoWay}" />
                                            <CheckBox
                                                Grid.Row="1"
                                                Grid.Column="1"
                                                Content="{x:Bind ViewModel.Text('desktop.day-5')}"
                                                IsChecked="{x:Bind ViewModel.Trigger.Friday, Mode=TwoWay}" />
                                            <CheckBox
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Content="{x:Bind ViewModel.Text('desktop.day-6')}"
                                                IsChecked="{x:Bind ViewModel.Trigger.Saturday, Mode=TwoWay}" />
                                        </Grid>
                                        <TimePicker
                                            Header="{x:Bind ViewModel.Text('desktop.schedule-node-time')}"
                                            Time="{x:Bind ViewModel.Trigger.CalendarTime, Mode=TwoWay}" />
                                    </StackPanel>
                                    <StackPanel
                                        Visibility="{x:Bind ViewModel.Trigger.IsSpecified, Mode=OneWay}">
                                        <TextBlock
                                            Text="{x:Bind ViewModel.Text('desktop.schedule-client-time')}"
                                            TextWrapping="Wrap" />
                                        <CalendarDatePicker
                                            Date="{x:Bind ViewModel.Trigger.SpecifiedDate, Mode=TwoWay}"
                                            Header="{x:Bind ViewModel.Text('desktop.schedule-date')}" />
                                        <TimePicker
                                            Header="{x:Bind ViewModel.Text('desktop.schedule-time')}"
                                            Time="{x:Bind ViewModel.Trigger.SpecifiedTime, Mode=TwoWay}" />
                                    </StackPanel>
                                    <TextBox
                                        Header="{x:Bind ViewModel.Text('desktop.schedule-runs-description')}"
                                        Text="{x:Bind ViewModel.RemainingRuns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox
                                        Header="{x:Bind ViewModel.Text('field.overlap-policy')}"
                                        SelectedIndex="{x:Bind ViewModel.OverlapIndex, Mode=TwoWay}">
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.schedule-overlap-skip')}" />
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.schedule-overlap-queue')}" />
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.schedule-overlap-concurrent')}" />
                                    </ComboBox>
                                    <CheckBox
                                        Content="{x:Bind ViewModel.Text('field.enabled')}"
                                        IsChecked="{x:Bind ViewModel.Enabled, Mode=TwoWay}"
                                        AutomationProperties.AutomationId="schedules:enabled" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Text('desktop.schedule-actions')}"
                                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                    <ListView
                                        ItemsSource="{x:Bind ViewModel.Actions}"
                                        SelectedItem="{x:Bind ViewModel.SelectedAction, Mode=TwoWay}"
                                        HorizontalContentAlignment="Stretch"
                                        AutomationProperties.AutomationId="schedules:actions">
                                        <ListView.ItemTemplate>
                                            <DataTemplate
                                                x:DataType="vm:ScheduleActionEditor">
                                                <StackPanel
                                                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                                                    <ComboBox
                                                        ItemsSource="{x:Bind Choices}"
                                                        DisplayMemberPath="Label"
                                                        SelectedValuePath="Value"
                                                        SelectedValue="{x:Bind Kind, Mode=OneWay}"
                                                        SelectionChanged="OnActionKindChanged"
                                                        AutomationProperties.AutomationId="schedules:action-kind" />
                                                    <TextBox
                                                        Header="{x:Bind ArgumentLabel, Mode=OneWay}"
                                                        Text="{x:Bind Argument, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Visibility="{x:Bind NeedsArgument, Mode=OneWay}"
                                                        AutomationProperties.AutomationId="schedules:action-argument" />
                                                    <CheckBox
                                                        Content="{x:Bind ContinueLabel}"
                                                        IsChecked="{x:Bind ContinueOnFailure, Mode=TwoWay}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListView.ItemTemplate>
                                    </ListView>
                                    <CommandBar
                                        HorizontalAlignment="Left"
                                        DefaultLabelPosition="Right"
                                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                        <AppBarButton
                                            Label="{x:Bind ViewModel.Text('desktop.schedule-add-action')}"
                                            Icon="Add"
                                            Command="{x:Bind ViewModel.AddActionCommand}" />
                                        <AppBarButton
                                            Label="{x:Bind ViewModel.Text('desktop.move-up')}"
                                            Icon="Up"
                                            Command="{x:Bind ViewModel.MoveUpCommand}" />
                                        <CommandBar.SecondaryCommands>
                                            <AppBarButton
                                                Label="{x:Bind ViewModel.Text('desktop.move-down')}"
                                                Command="{x:Bind ViewModel.MoveDownCommand}" />
                                            <AppBarButton
                                                Label="{x:Bind ViewModel.Text('desktop.schedule-remove-action')}"
                                                Command="{x:Bind ViewModel.RemoveActionCommand}" />
                                        </CommandBar.SecondaryCommands>
                                    </CommandBar>
                                </StackPanel>
                            </ContentControl>
                            <Expander
                                Header="{x:Bind ViewModel.Text('action.view-history')}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                Visibility="{x:Bind ViewModel.CanViewHistory, Mode=OneWay}">
                                <StackPanel
                                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                                    <Button
                                        Content="{x:Bind ViewModel.Text('action.refresh')}"
                                        Command="{x:Bind ViewModel.ViewHistoryCommand}" />
                                    <TextBlock
                                        Text="{x:Bind ViewModel.Text('desktop.schedule-history-next')}"
                                        Visibility="{x:Bind ViewModel.NoHistory, Mode=OneWay}"
                                        TextWrapping="Wrap" />
                                    <ItemsControl
                                        ItemsSource="{x:Bind ViewModel.History, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock
                                                        Text="{Binding Started}" />
                                                    <TextBlock
                                                        Text="{Binding Result}" />
                                                    <TextBlock
                                                        Text="{Binding Details}"
                                                        TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition
                                Width="*" />
                            <ColumnDefinition
                                Width="Auto" />
                            <ColumnDefinition
                                Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Text="{x:Bind ViewModel.DirtyText, Mode=OneWay}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Content="{x:Bind ViewModel.Text('common.cancel')}"
                            Command="{x:Bind ViewModel.CloseEditorCommand}" />
                        <Button
                            Grid.Column="2"
                            Content="{x:Bind ViewModel.Text('action.save')}"
                            Command="{x:Bind ViewModel.SaveCommand}"
                            Style="{ThemeResource AccentButtonStyle}"
                            AutomationProperties.AutomationId="schedules:save" />
                    </Grid>
                </Grid>
            </SplitView.Pane>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Padding="{ThemeResource TextControlThemePadding}"
                    ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="2*" />
                        <ColumnDefinition
                            Width="2*" />
                        <ColumnDefinition
                            Width="2*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('field.name')}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.Text('field.trigger')}" />
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind ViewModel.Text('desktop.schedule-next-run')}" />
                    <TextBlock
                        Grid.Column="3"
                        Text="{x:Bind ViewModel.Text('desktop.schedule-last-result')}" />
                    <TextBlock
                        Grid.Column="4"
                        Text="{x:Bind ViewModel.Text('field.enabled')}" />
                    <TextBlock
                        Grid.Column="5"
                        Text="{x:Bind ViewModel.Text('action.run-now')}" />
                </Grid>
                <ListView
                    x:Name="TaskList"
                    Grid.Row="1"
                    ItemsSource="{x:Bind ViewModel.Schedules, Mode=OneWay}"
                    SelectedItem="{x:Bind ViewModel.SelectedTask, Mode=OneWay}"
                    SelectionChanged="OnTaskSelected"
                    HorizontalContentAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.CanRead, Mode=OneWay}"
                    AutomationProperties.AutomationId="schedules:list">
                    <ListView.ItemTemplate>
                        <DataTemplate
                            x:DataType="vm:ScheduleRow">
                            <Grid
                                Padding="{ThemeResource TextControlThemePadding}"
                                ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition
                                        Width="2*" />
                                    <ColumnDefinition
                                        Width="2*" />
                                    <ColumnDefinition
                                        Width="2*" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="*" />
                                    <ColumnDefinition
                                        Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{x:Bind Trigger, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="2"
                                    Text="{x:Bind NextRun, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Grid.Column="3"
                                    Text="{x:Bind LastResult, Mode=OneWay}"
                                    TextWrapping="Wrap"
                                    VerticalAlignment="Center" />
                                <ToggleSwitch
                                    Grid.Column="4"
                                    MinWidth="0"
                                    OnContent=""
                                    OffContent=""
                                    IsOn="{x:Bind Enabled, Mode=OneWay}"
                                    IsEnabled="{x:Bind CanOperate, Mode=OneWay}"
                                    Toggled="OnTaskToggled"
                                    AutomationProperties.Name="{x:Bind Name}"
                                    AutomationProperties.AutomationId="schedules:toggle" />
                                <Button
                                    Grid.Column="5"
                                    IsEnabled="{x:Bind CanOperate, Mode=OneWay}"
                                    Click="OnRunNow"
                                    AutomationProperties.Name="{x:Bind RunLabel}"
                                    ToolTipService.ToolTip="{x:Bind RunLabel}"
                                    AutomationProperties.AutomationId="schedules:run">
                                    <SymbolIcon
                                        Symbol="Play" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.Text('desktop.schedules-empty-next')}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
            </Grid>
        </SplitView>
        <TextBlock
            Grid.Row="3"
            Text="{x:Bind ViewModel.Count, Mode=OneWay}" />
    </Grid>
</UserControl>
