<UserControl
    x:Class="Servitium.Desktop.Views.Instances.InstanceConsolePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.AutomationId="PG-012"
    AutomationProperties.AccessibilityView="Content"
    AutomationProperties.Name="{x:Bind ViewModel.Text('desktop.tab-console')}">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Enter"
            Invoked="OnSendInvoked" />
    </UserControl.KeyboardAccelerators>
    <Grid
        RowSpacing="{ThemeResource SelectorBarItemSpacing}"
        SizeChanged="OnLayoutChanged">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="{x:Bind ViewModel.Severity, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasStateMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.StateMessage, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False" />
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>
        <Grid
            Grid.Row="1"
            ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="3*" />
                <ColumnDefinition
                    x:Name="InspectorColumn"
                    Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                RowSpacing="{ThemeResource SelectorBarItemSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="*" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <Grid>
                    <ContentPresenter
                        x:Name="TerminalHost"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch" />
                    <ScrollViewer
                        Visibility="{x:Bind ViewModel.HasRunningNote, Mode=OneWay}">
                        <TextBlock
                            Text="{x:Bind ViewModel.OutputFallback, Mode=OneWay}"
                            FontFamily="{ThemeResource ContentControlThemeFontFamily}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
                <TextBlock
                    Grid.Row="1"
                    Text="{x:Bind ViewModel.RunningNote, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasRunningNote, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Grid
                    Grid.Row="2"
                    ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="CommandBox"
                        PlaceholderText="{x:Bind ViewModel.Text('desktop.console-command')}"
                        Text="{x:Bind ViewModel.Command, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        IsEnabled="{x:Bind ViewModel.CanType, Mode=OneWay}"
                        AutomationProperties.AutomationId="console:command" />
                    <Button
                        Grid.Column="1"
                        Content="{x:Bind ViewModel.Text('desktop.console-send')}"
                        Command="{x:Bind ViewModel.SendCommand}"
                        AutomationProperties.AutomationId="console:send" />
                    <Button
                        Grid.Column="2"
                        Content="{x:Bind ViewModel.Text('desktop.console-inspector')}"
                        Click="OnInspectorClick" />
                </Grid>
                <ItemsControl
                    IsEnabled="{x:Bind ViewModel.CanType, Mode=OneWay}"
                    x:Name="ShortcutItems"
                    Grid.Row="3"
                    ItemsSource="{x:Bind ViewModel.Shortcuts, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasShortcuts, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel
                                Orientation="Horizontal"
                                Spacing="{ThemeResource SelectorBarItemSpacing}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button
                                Content="{Binding Name}"
                                Click="OnShortcutClick" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
            <ScrollViewer
                x:Name="Inspector"
                Grid.Column="1"
                HorizontalScrollBarVisibility="Disabled">
                <StackPanel
                    Spacing="{ThemeResource SelectorBarItemSpacing}"
                    Padding="{ThemeResource TextControlThemePadding}">
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.console-inspector')}"
                        Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.console-players-title')}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Players, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <ItemsControl
                        ItemsSource="{x:Bind ViewModel.PlayerNames, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.console-resources-title')}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Resources, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Uptime, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.server-version')}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Version, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.player-address')}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Address}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('field.java-runtime')}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Java, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <HyperlinkButton
                        Content="{x:Bind ViewModel.Text('field.working-directory')}"
                        Click="OnWorkingDirectoryClick" />
                    <TextBlock
                        Text="{x:Bind ViewModel.WorkingDirectory}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.auto-start')}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.AutomaticStart, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.auto-restart')}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.AutomaticRestart, Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.associated-channel')}"
                        Style="{ThemeResource BodyStrongTextBlockStyle}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Channel, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
