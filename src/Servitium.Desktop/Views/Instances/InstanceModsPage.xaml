<UserControl
    x:Class="Servitium.Desktop.Views.Instances.InstanceModsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:Servitium.Desktop.ViewModels.Instances"
    AutomationProperties.Name="{x:Bind ViewModel.Text('desktop.tab-mods')}">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="F5"
            Invoked="OnRefreshInvoked" />
    </UserControl.KeyboardAccelerators>
    <Grid
        RowSpacing="{ThemeResource SelectorBarItemSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="{x:Bind ViewModel.Severity, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsOffline, Mode=OneWay}"
                Message="{x:Bind ViewModel.Text('desktop.instance-offline-next')}"
                Severity="Warning"
                IsClosable="False" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsRunning, Mode=OneWay}"
                Message="{x:Bind ViewModel.Text('desktop.mods-running-next')}"
                Severity="Informational"
                IsClosable="False" />
        </StackPanel>
        <Grid
            Grid.Row="1"
            ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <ComboBox
                x:Name="KindSelector"
                SelectedIndex="{x:Bind ViewModel.KindIndex, Mode=OneWay}"
                SelectionChanged="OnKindChanged"
                IsEnabled="{x:Bind ViewModel.CanRead, Mode=OneWay}"
                AutomationProperties.Name="{x:Bind ViewModel.Text('field.type')}">
                <ComboBoxItem
                    Content="{x:Bind ViewModel.Text('desktop.mods-kind-mods')}" />
                <ComboBoxItem
                    Content="{x:Bind ViewModel.Text('desktop.mods-kind-plugins')}" />
            </ComboBox>
            <TextBox
                Grid.Column="1"
                PlaceholderText="{x:Bind ViewModel.Text('desktop.mods-filter')}"
                Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                AutomationProperties.Name="{x:Bind ViewModel.Text('desktop.mods-filter')}" />
            <ComboBox
                Grid.Column="2"
                SelectedIndex="{x:Bind ViewModel.EnabledFilter, Mode=TwoWay}"
                AutomationProperties.Name="{x:Bind ViewModel.Text('field.enabled')}">
                <ComboBoxItem
                    Content="{x:Bind ViewModel.Text('common.all')}" />
                <ComboBoxItem
                    Content="{x:Bind ViewModel.Text('state.enabled')}" />
                <ComboBoxItem
                    Content="{x:Bind ViewModel.Text('state.disabled')}" />
            </ComboBox>
        </Grid>
        <CommandBar
            Grid.Row="2"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Left"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <AppBarButton
                Label="{x:Bind ViewModel.Text('action.upload')}"
                Icon="Upload"
                Command="{x:Bind ViewModel.UploadCommand}"
                AutomationProperties.AutomationId="mods:upload" />
            <AppBarButton
                Label="{x:Bind ViewModel.Text('desktop.mods-rescan')}"
                Icon="Refresh"
                Command="{x:Bind ViewModel.RefreshCommand}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.details')}"
                    IsEnabled="{x:Bind ViewModel.CanChangeSelected, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <Flyout>
                            <ScrollViewer
                                HorizontalScrollBarVisibility="Disabled">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Details, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.open-configuration')}"
                    IsEnabled="{x:Bind ViewModel.CanChangeSelected, Mode=OneWay}"
                    Click="OnFindConfiguration">
                    <AppBarButton.Flyout>
                        <Flyout
                            x:Name="ConfigurationFlyout">
                            <StackPanel
                                Spacing="{ThemeResource SelectorBarItemSpacing}">
                                <TextBlock
                                    Text="{x:Bind ViewModel.Text('desktop.mods-no-configuration')}"
                                    Visibility="{x:Bind ViewModel.NoConfigurationFiles, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <ComboBox
                                    ItemsSource="{x:Bind ViewModel.ConfigurationFiles, Mode=OneWay}"
                                    SelectedItem="{x:Bind ViewModel.SelectedConfiguration, Mode=TwoWay}"
                                    Header="{x:Bind ViewModel.Text('desktop.config-files')}" />
                                <Button
                                    Content="{x:Bind ViewModel.Text('action.open-file-manager')}"
                                    IsEnabled="{x:Bind ViewModel.CanOpenConfiguration, Mode=OneWay}"
                                    Click="OnOpenConfiguration" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.delete')}"
                    Icon="Delete"
                    Command="{x:Bind ViewModel.DeleteCommand}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <Grid
            Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition
                    Height="Auto" />
                <RowDefinition
                    Height="*" />
            </Grid.RowDefinitions>
            <Grid
                Padding="{ThemeResource TextControlThemePadding}"
                ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition
                        Width="3*" />
                    <ColumnDefinition
                        Width="*" />
                    <ColumnDefinition
                        Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Text="{x:Bind ViewModel.Text('field.name')}" />
                <TextBlock
                    Grid.Column="1"
                    Text="{x:Bind ViewModel.Text('desktop.mod-version')}" />
                <TextBlock
                    Grid.Column="2"
                    Text="{x:Bind ViewModel.Text('field.enabled')}" />
            </Grid>
            <ListView
                Grid.Row="1"
                ItemsSource="{x:Bind ViewModel.Mods, Mode=OneWay}"
                SelectedItem="{x:Bind ViewModel.SelectedMod, Mode=TwoWay}"
                SelectionMode="Single"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="mods:list">
                <ListView.ItemTemplate>
                    <DataTemplate
                        x:DataType="vm:ModRow">
                        <Grid
                            Padding="{ThemeResource TextControlThemePadding}"
                            ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="3*" />
                                <ColumnDefinition
                                    Width="*" />
                                <ColumnDefinition
                                    Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind Name}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Version}"
                                VerticalAlignment="Center" />
                            <ToggleSwitch
                                Grid.Column="2"
                                MinWidth="0"
                                OnContent=""
                                OffContent=""
                                IsOn="{x:Bind Enabled, Mode=OneWay}"
                                IsEnabled="{x:Bind CanToggle, Mode=OneWay}"
                                Toggled="OnModToggled"
                                AutomationProperties.Name="{x:Bind Name}"
                                AutomationProperties.AutomationId="mods:toggle" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
            <TextBlock
                Grid.Row="1"
                Text="{x:Bind ViewModel.Text('desktop.mods-empty-next')}"
                TextWrapping="Wrap"
                Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
        </Grid>
        <StackPanel
            Grid.Row="4"
            Spacing="{ThemeResource SelectorBarItemSpacing}">
            <StackPanel
                Visibility="{x:Bind ViewModel.IsUploading, Mode=OneWay}">
                <ProgressBar
                    Value="{x:Bind ViewModel.TransferPercent, Mode=OneWay}" />
                <TextBlock
                    Text="{x:Bind ViewModel.TransferText, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    Content="{x:Bind ViewModel.Text('common.cancel')}"
                    Command="{x:Bind ViewModel.CancelCommand}" />
            </StackPanel>
            <TextBlock
                Text="{x:Bind ViewModel.Count, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.Text('desktop.mods-boundary')}"
                Style="{ThemeResource CaptionTextBlockStyle}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
