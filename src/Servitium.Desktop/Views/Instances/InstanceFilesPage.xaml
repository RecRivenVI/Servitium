<UserControl
    x:Class="Servitium.Desktop.Views.Instances.InstanceFilesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AllowDrop="True"
    DragOver="OnDragOver"
    Drop="OnDrop"
    AutomationProperties.AutomationId="PG-013"
    AutomationProperties.Name="{x:Bind ViewModel.Text('desktop.tab-files')}">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control"
            Invoked="OnSaveInvoked" />
        <KeyboardAccelerator
            Key="W"
            Modifiers="Control"
            Invoked="OnCloseTabInvoked" />
        <KeyboardAccelerator
            Key="Enter"
            Invoked="OnOpenInvoked" />
    </UserControl.KeyboardAccelerators>
    <Grid
        SizeChanged="OnLayoutChanged">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="{x:Bind ViewModel.Severity, Mode=OneWay}" />
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        </StackPanel>
        <TabView
            x:Name="DirectoryTabs"
            Grid.Row="1"
            TabItemsSource="{x:Bind ViewModel.Tabs}"
            SelectedItem="{x:Bind ViewModel.SelectedTab, Mode=OneWay}"
            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
            Visibility="{x:Bind ViewModel.ShowTabs, Mode=OneWay}"
            SelectionChanged="OnTabSelectionChanged"
            TabCloseRequested="OnTabCloseRequested"
            AddTabButtonClick="OnAddTabClick"
            IsAddTabButtonVisible="{x:Bind ViewModel.CanSelect, Mode=OneWay}">
            <TabView.TabItemTemplate>
                <DataTemplate>
                    <TabViewItem
                        Header="{Binding Header}"
                        IsClosable="{Binding CanClose}" />
                </DataTemplate>
            </TabView.TabItemTemplate>
        </TabView>
        <BreadcrumbBar
            Grid.Row="2"
            ItemsSource="{x:Bind ViewModel.Breadcrumbs, Mode=OneWay}"
            ItemClicked="OnBreadcrumbClick"
            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}">
            <BreadcrumbBar.ItemTemplate>
                <DataTemplate>
                    <TextBlock
                        Text="{Binding Name}" />
                </DataTemplate>
            </BreadcrumbBar.ItemTemplate>
        </BreadcrumbBar>
        <CommandBar
            Grid.Row="3"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Left"
            Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
            Visibility="{x:Bind ViewModel.ShowFiles, Mode=OneWay}">
            <AppBarButton
                Label="{x:Bind ViewModel.Text('action.upload')}"
                Icon="Upload"
                Command="{x:Bind ViewModel.UploadCommand}"
                AutomationProperties.AutomationId="files:upload" />
            <AppBarButton
                Label="{x:Bind ViewModel.Text('action.create-directory')}"
                Icon="NewFolder"
                Command="{x:Bind ViewModel.CreateDirectoryCommand}" />
            <AppBarButton
                Label="{x:Bind ViewModel.Text('action.create-file')}"
                Icon="NewWindow"
                Command="{x:Bind ViewModel.CreateFileCommand}" />
            <AppBarButton
                Label="{x:Bind ViewModel.Text('action.paste')}"
                Icon="Paste"
                Command="{x:Bind ViewModel.PasteCommand}" />
            <AppBarButton
                Label="{x:Bind ViewModel.Text('action.refresh')}"
                Icon="Refresh"
                Command="{x:Bind ViewModel.RefreshCommand}" />
            <CommandBar.SecondaryCommands>
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('desktop.files-options')}"
                    IsEnabled="{x:Bind ViewModel.CanSelect, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <Flyout>
                            <ScrollViewer
                                x:Name="OptionsScroll"
                                HorizontalScrollBarVisibility="Disabled">
                                <StackPanel
                                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                                    <TextBox
                                        Header="{x:Bind ViewModel.Text('desktop.filter-files')}"
                                        Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <ComboBox
                                        Header="{x:Bind ViewModel.Text('desktop.sort-files')}"
                                        SelectedIndex="{x:Bind ViewModel.Sort, Mode=TwoWay}">
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('field.name')}" />
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.file-size-title')}" />
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.file-modified')}" />
                                    </ComboBox>
                                    <CheckBox
                                        Content="{x:Bind ViewModel.Text('desktop.sort-descending')}"
                                        IsChecked="{x:Bind ViewModel.Descending, Mode=TwoWay}" />
                                    <ComboBox
                                        Header="{x:Bind ViewModel.Text('desktop.collision-policy')}"
                                        SelectedIndex="{x:Bind ViewModel.Collision, Mode=TwoWay}">
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.collision-reject')}" />
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.collision-overwrite')}" />
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.collision-keep-both')}" />
                                        <ComboBoxItem
                                            Content="{x:Bind ViewModel.Text('desktop.collision-skip')}" />
                                    </ComboBox>
                                    <CheckBox
                                        Content="{x:Bind ViewModel.Text('desktop.upload-overwrite')}"
                                        IsChecked="{x:Bind ViewModel.Overwrite, Mode=TwoWay}" />
                                    <ComboBox
                                        Header="{x:Bind ViewModel.Text('field.encoding')}"
                                        ItemsSource="{x:Bind ViewModel.Encodings}"
                                        DisplayMemberPath="Label"
                                        SelectedValuePath="Value"
                                        SelectedValue="{x:Bind ViewModel.TextEncoding, Mode=TwoWay}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('desktop.files-new-tab')}"
                    Command="{x:Bind ViewModel.NewTabCommand}" />
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.download')}"
                    Command="{x:Bind ViewModel.DownloadCommand}" />
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.edit-text')}"
                    Command="{x:Bind ViewModel.EditTextCommand}" />
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('desktop.preview-image')}"
                    Command="{x:Bind ViewModel.PreviewCommand}" />
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.rename')}"
                    Command="{x:Bind ViewModel.RenameCommand}" />
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.copy')}"
                    Command="{x:Bind ViewModel.CopyCommand}" />
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.cut')}"
                    Command="{x:Bind ViewModel.CutCommand}" />
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.move')}"
                    Command="{x:Bind ViewModel.MoveCommand}" />
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.compress')}"
                    IsEnabled="{x:Bind ViewModel.CanMutateSelection, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <Flyout
                            x:Name="CompressFlyout">
                            <StackPanel
                                Spacing="{ThemeResource SelectorBarItemSpacing}"
                                MaxWidth="{ThemeResource ContentDialogMaxWidth}">
                                <TextBox
                                    Header="{x:Bind ViewModel.Text('desktop.archive-destination')}"
                                    Text="{x:Bind ViewModel.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox
                                    Header="{x:Bind ViewModel.Text('desktop.archive-encoding')}"
                                    ItemsSource="{x:Bind ViewModel.ArchiveEncodings}"
                                    DisplayMemberPath="Label"
                                    SelectedValuePath="Value"
                                    SelectedValue="{x:Bind ViewModel.ArchiveEncoding, Mode=TwoWay}" />
                                <Button
                                    Content="{x:Bind ViewModel.Text('action.compress')}"
                                    Command="{x:Bind ViewModel.CompressCommand}"
                                    Click="OnOperationClick" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.extract')}"
                    IsEnabled="{x:Bind ViewModel.CanMutateFile, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <Flyout
                            x:Name="ExtractFlyout">
                            <StackPanel
                                Spacing="{ThemeResource SelectorBarItemSpacing}"
                                MaxWidth="{ThemeResource ContentDialogMaxWidth}">
                                <TextBox
                                    Header="{x:Bind ViewModel.Text('desktop.extract-destination')}"
                                    Text="{x:Bind ViewModel.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox
                                    Header="{x:Bind ViewModel.Text('desktop.archive-encoding')}"
                                    ItemsSource="{x:Bind ViewModel.ArchiveEncodings}"
                                    DisplayMemberPath="Label"
                                    SelectedValuePath="Value"
                                    SelectedValue="{x:Bind ViewModel.ExtractEncoding, Mode=TwoWay}" />
                                <Button
                                    Content="{x:Bind ViewModel.Text('action.extract')}"
                                    Command="{x:Bind ViewModel.ExtractCommand}"
                                    Click="OnOperationClick" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.download-from-url')}"
                    IsEnabled="{x:Bind ViewModel.CanMutate, Mode=OneWay}">
                    <AppBarButton.Flyout>
                        <Flyout
                            x:Name="DownloadUrlFlyout">
                            <StackPanel
                                Spacing="{ThemeResource SelectorBarItemSpacing}"
                                MaxWidth="{ThemeResource ContentDialogMaxWidth}">
                                <TextBox
                                    Header="{x:Bind ViewModel.Text('field.url')}"
                                    Text="{x:Bind ViewModel.Url, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Header="{x:Bind ViewModel.Text('desktop.relative-destination')}"
                                    Text="{x:Bind ViewModel.Destination, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <CheckBox
                                    Content="{x:Bind ViewModel.Text('desktop.allow-overwrite')}"
                                    IsChecked="{x:Bind ViewModel.Overwrite, Mode=TwoWay}" />
                                <Button
                                    Content="{x:Bind ViewModel.Text('action.download-from-url')}"
                                    Command="{x:Bind ViewModel.DownloadUrlCommand}"
                                    Click="OnOperationClick" />
                            </StackPanel>
                        </Flyout>
                    </AppBarButton.Flyout>
                </AppBarButton>
                <AppBarSeparator />
                <AppBarButton
                    Label="{x:Bind ViewModel.Text('action.delete')}"
                    Command="{x:Bind ViewModel.DeleteCommand}" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
        <StackPanel
            Grid.Row="4"
            Spacing="{ThemeResource SelectorBarItemSpacing}">
            <InfoBar
                IsOpen="{x:Bind ViewModel.RequiresStopped, Mode=OneWay}"
                Message="{x:Bind ViewModel.Text('desktop.files-running-warning')}"
                Severity="Informational"
                IsClosable="False" />
        </StackPanel>
        <StackPanel
            Grid.Row="5"
            Spacing="{ThemeResource SelectorBarItemSpacing}"
            Visibility="{x:Bind ViewModel.IsTransferring, Mode=OneWay}">
            <ProgressBar
                Value="{x:Bind ViewModel.TransferPercent, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.TransferText, Mode=OneWay}"
                TextWrapping="Wrap" />
            <StackPanel
                Orientation="Horizontal"
                Spacing="{ThemeResource SelectorBarItemSpacing}">
                <Button
                    Content="{x:Bind ViewModel.Text('action.pause')}"
                    Command="{x:Bind ViewModel.PauseCommand}" />
                <Button
                    Content="{x:Bind ViewModel.Text('action.resume')}"
                    Command="{x:Bind ViewModel.ResumeCommand}" />
                <Button
                    Content="{x:Bind ViewModel.Text('common.cancel')}"
                    Command="{x:Bind ViewModel.CancelCommand}" />
            </StackPanel>
        </StackPanel>
        <Grid
            Grid.Row="6">
            <Grid
                Visibility="{x:Bind ViewModel.ShowFiles, Mode=OneWay}"
                RowSpacing="{ThemeResource SelectorBarItemSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <Grid
                    ColumnSpacing="{ThemeResource SelectorBarItemSpacing}"
                    Padding="{ThemeResource TextControlThemePadding}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="3*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="2*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('field.name')}" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.Text('desktop.file-kind')}" />
                    <TextBlock
                        Grid.Column="2"
                        Text="{x:Bind ViewModel.Text('desktop.file-size-title')}" />
                    <TextBlock
                        Grid.Column="3"
                        Text="{x:Bind ViewModel.Text('desktop.file-modified')}" />
                </Grid>
                <Grid
                    Grid.Row="1">
                    <ListView
                        x:Name="FileList"
                        ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanSelect, Mode=OneWay}"
                        SelectionMode="Extended"
                        SelectionChanged="OnFileSelectionChanged"
                        DoubleTapped="OnFileDoubleTapped"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="files:list">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid
                                    Padding="{ThemeResource TextControlThemePadding}"
                                    ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="3*" />
                                        <ColumnDefinition
                                            Width="*" />
                                        <ColumnDefinition
                                            Width="*" />
                                        <ColumnDefinition
                                            Width="2*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel
                                        Orientation="Horizontal"
                                        Spacing="{ThemeResource SelectorBarItemSpacing}">
                                        <FontIcon
                                            Glyph="{Binding Glyph}" />
                                        <TextBlock
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{Binding Kind}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="2"
                                        Text="{Binding Size}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Grid.Column="3"
                                        Text="{Binding Modified}"
                                        TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.files-empty-next')}"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextWrapping="Wrap" />
                </Grid>
                <StackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                    <TextBlock
                        Text="{x:Bind ViewModel.Count, Mode=OneWay}"
                        VerticalAlignment="Center" />
                    <Button
                        Content="{x:Bind ViewModel.Text('common.load-more')}"
                        Command="{x:Bind ViewModel.LoadMoreCommand}"
                        Visibility="{x:Bind ViewModel.HasMore, Mode=OneWay}" />
                </StackPanel>
                <TextBlock
                    Grid.Row="3"
                    Text="{x:Bind ViewModel.Text('desktop.files-boundary')}"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
            </Grid>
            <Grid
                Visibility="{x:Bind ViewModel.IsEditing, Mode=OneWay}"
                RowSpacing="{ThemeResource SelectorBarItemSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                    <RowDefinition
                        Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock
                    Text="{x:Bind ViewModel.EditorTitle, Mode=OneWay}"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />
                <ContentPresenter
                    x:Name="EditorHost"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
                <StackPanel
                    Grid.Row="2"
                    Orientation="Horizontal"
                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                    <ComboBox
                        Header="{x:Bind ViewModel.Text('field.encoding')}"
                        ItemsSource="{x:Bind ViewModel.WriteEncodings}"
                        DisplayMemberPath="Label"
                        SelectedValuePath="Value"
                        SelectedValue="{x:Bind ViewModel.TextEncoding, Mode=TwoWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('state.dirty')}"
                        Visibility="{x:Bind ViewModel.IsDirty, Mode=OneWay}"
                        VerticalAlignment="Center" />
                    <Button
                        Content="{x:Bind ViewModel.Text('action.save')}"
                        Command="{x:Bind ViewModel.SaveTextCommand}"
                        Style="{ThemeResource AccentButtonStyle}" />
                    <Button
                        Content="{x:Bind ViewModel.Text('common.close')}"
                        Command="{x:Bind ViewModel.CloseEditorCommand}" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
