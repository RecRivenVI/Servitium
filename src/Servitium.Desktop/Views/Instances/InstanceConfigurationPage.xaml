                                                Text="{x:Bind ViewModel.MaxTickTime.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.MaxTickTime.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.PauseWhenEmptySeconds.Title}"
