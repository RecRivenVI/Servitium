                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Visibility="{x:Bind ViewModel.IsRaw, Mode=OneWay}" />
                </Grid>
            </Grid>
        </SplitView>
        <Grid
            Grid.Row="3"
            Padding="{ThemeResource TextControlThemePadding}"
            Visibility="{x:Bind ViewModel.HasFile, Mode=OneWay}"
            ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition
                    Width="*" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
                <ColumnDefinition
                    Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock
                    Text="{x:Bind ViewModel.DirtySummary, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.Validation, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.HasValidation, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Content="{x:Bind ViewModel.Text('action.details')}">
                <Button.Flyout>
                    <Flyout>
                        <StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.FileNotice, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind ViewModel.Restriction, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Text="{x:Bind ViewModel.DirtyDetails, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
            <Button
                Grid.Column="2"
                Content="{x:Bind ViewModel.Text('action.discard')}"
                Command="{x:Bind ViewModel.DiscardCommand}" />
            <Button
                Grid.Column="3"
                Content="{x:Bind ViewModel.Text('action.save')}"
                Command="{x:Bind ViewModel.SaveCommand}"
                Style="{ThemeResource AccentButtonStyle}"
                AutomationProperties.AutomationId="configuration:save" />
        </Grid>
    </Grid>
</UserControl>
