                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.SimulationDistance.Title}"
                                            Description="{x:Bind ViewModel.SimulationDistance.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.SimulationDistance.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
