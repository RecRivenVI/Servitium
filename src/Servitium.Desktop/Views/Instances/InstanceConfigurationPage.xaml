                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                                <settings:SettingsExpander
                                    Header="{x:Bind ViewModel.Text('desktop.config-performance')}">
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.ViewDistance.Title}"
                                            Description="{x:Bind ViewModel.ViewDistance.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.ViewDistance.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
