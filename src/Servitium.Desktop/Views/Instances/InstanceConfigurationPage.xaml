                                            Description="{x:Bind ViewModel.EntityBroadcastRangePercentage.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.EntityBroadcastRangePercentage.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.EntityBroadcastRangePercentage.Title}" />
