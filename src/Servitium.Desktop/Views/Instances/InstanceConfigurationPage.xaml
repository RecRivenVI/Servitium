<UserControl
    x:Class="Servitium.Desktop.Views.Instances.InstanceConfigurationPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls"
    AutomationProperties.Name="{x:Bind ViewModel.Text('desktop.tab-configuration')}">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control"
            Invoked="OnSaveInvoked" />
    </UserControl.KeyboardAccelerators>
    <Grid
        x:Name="LayoutRoot"
        SizeChanged="OnLayoutSizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <ProgressBar
            IsIndeterminate="True"
            Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
        <InfoBar
            Grid.Row="1"
            IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
            Severity="{x:Bind ViewModel.Severity, Mode=OneWay}"
            Message="{x:Bind ViewModel.Message, Mode=OneWay}" />
        <SplitView
            x:Name="FilesSplit"
            Grid.Row="2"
            DisplayMode="Inline"
            IsPaneOpen="True"
            PaneBackground="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <SplitView.Pane>
                <Grid
                    Padding="{ThemeResource TextControlThemePadding}"
                    RowSpacing="{ThemeResource SelectorBarItemSpacing}">
                    <Grid.RowDefinitions>
                        <RowDefinition
                            Height="Auto" />
                        <RowDefinition
                            Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        Header="{x:Bind ViewModel.Text('desktop.config-files')}"
                        Text="{x:Bind ViewModel.Search, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ListView
                        x:Name="FilesList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ViewModel.Files, Mode=OneWay}"
                        SelectedItem="{x:Bind ViewModel.SelectedFile, Mode=OneWay}"
                        SelectionChanged="OnFileSelected"
                        IsEnabled="{x:Bind ViewModel.CanRead, Mode=OneWay}"
                        AutomationProperties.AutomationId="configuration:files">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Text="{Binding Path}"
                                        Style="{ThemeResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </SplitView.Pane>
            <Grid
                RowSpacing="{ThemeResource SelectorBarItemSpacing}">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    ColumnSpacing="{ThemeResource SelectorBarItemSpacing}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition
                            Width="*" />
                        <ColumnDefinition
                            Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <CommandBar
                        HorizontalAlignment="Left"
                        DefaultLabelPosition="Right"
                        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                        <AppBarButton
                            x:Name="FilesButton"
                            Label="{x:Bind ViewModel.FileTitle, Mode=OneWay}"
                            Icon="Folder"
                            Click="OnShowFiles"
                            ToolTipService.ToolTip="{x:Bind ViewModel.Text('desktop.config-files')}" />
                        <AppBarButton
                            Label="{x:Bind ViewModel.Text('action.refresh')}"
                            Icon="Refresh"
                            Command="{x:Bind ViewModel.RefreshCommand}" />
                        <CommandBar.SecondaryCommands>
                            <AppBarButton
                                Label="{x:Bind ViewModel.Text('action.open-file-manager')}"
                                Icon="OpenFile"
                                Command="{x:Bind ViewModel.OpenFilesCommand}" />
                            <AppBarButton
                                Label="{x:Bind ViewModel.Text('action.view-backups')}"
                                IsEnabled="{x:Bind ViewModel.CanViewBackups, Mode=OneWay}"
                                Click="OnBackupsClick">
                                <AppBarButton.Flyout>
                                    <Flyout
                                        x:Name="BackupsFlyout">
                                        <StackPanel
                                            Spacing="{ThemeResource SelectorBarItemSpacing}">
                                            <TextBlock
                                                Text="{x:Bind ViewModel.Text('desktop.config-backups-description')}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.Text('desktop.config-no-backups')}"
                                                TextWrapping="Wrap"
                                                Visibility="{x:Bind ViewModel.BackupsEmpty, Mode=OneWay}" />
                                            <ComboBox
                                                ItemsSource="{x:Bind ViewModel.Backups, Mode=OneWay}"
                                                DisplayMemberPath="Label"
                                                SelectedItem="{x:Bind ViewModel.SelectedBackup, Mode=TwoWay}"
                                                Header="{x:Bind ViewModel.Text('action.view-backups')}" />
                                            <Button
                                                Content="{x:Bind ViewModel.Text('action.restore')}"
                                                Click="OnRestoreBackup"
                                                IsEnabled="{x:Bind ViewModel.CanRestoreBackup, Mode=OneWay}" />
                                        </StackPanel>
                                    </Flyout>
                                </AppBarButton.Flyout>
                            </AppBarButton>
                        </CommandBar.SecondaryCommands>
                    </CommandBar>
                    <SelectorBar
                        Grid.Column="1"
                        x:Name="ViewSelector"
                        SelectionChanged="OnViewSelected"
                        Visibility="{x:Bind ViewModel.HasStructuredView, Mode=OneWay}">
                        <SelectorBarItem
                            x:Name="StructuredItem"
                            Text="{x:Bind ViewModel.Text('desktop.config-structured')}"
                            IsSelected="True" />
                        <SelectorBarItem
                            x:Name="RawItem"
                            Text="{x:Bind ViewModel.Text('desktop.config-raw')}" />
                    </SelectorBar>
                </Grid>
                <StackPanel
                    Grid.Row="1"
                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.config-empty-next')}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind ViewModel.IsEmpty, Mode=OneWay}" />
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.IsReadOnly, Mode=OneWay}"
                        Message="{x:Bind ViewModel.Restriction, Mode=OneWay}"
                        Severity="Warning"
                        IsClosable="False" />
                </StackPanel>
                <Grid
                    Grid.Row="2">
                    <ScrollViewer
                        Visibility="{x:Bind ViewModel.ShowStructured, Mode=OneWay}"
                        HorizontalScrollBarVisibility="Disabled">
                        <ContentControl
                            HorizontalContentAlignment="Stretch">
                            <StackPanel
                                Spacing="{ThemeResource SelectorBarItemSpacing}">
                                <settings:SettingsExpander
                                    Header="{x:Bind ViewModel.Text('desktop.config-network')}"
                                    IsExpanded="True">
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.ServerIp.Title}"
                                            Description="{x:Bind ViewModel.ServerIp.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.ServerIp.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.ServerIp.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.ServerPort.Title}"
                                            Description="{x:Bind ViewModel.ServerPort.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.ServerPort.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.ServerPort.Title}"
                                                AutomationProperties.AutomationId="configuration:server-port" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.EnableStatus.Title}"
                                            Description="{x:Bind ViewModel.EnableStatus.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.EnableStatus.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.EnableStatus.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.EnableQuery.Title}"
                                            Description="{x:Bind ViewModel.EnableQuery.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.EnableQuery.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.EnableQuery.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.QueryPort.Title}"
                                            Description="{x:Bind ViewModel.QueryPort.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.QueryPort.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.QueryPort.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.EnableRcon.Title}"
                                            Description="{x:Bind ViewModel.EnableRcon.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.EnableRcon.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.EnableRcon.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.RconPort.Title}"
                                            Description="{x:Bind ViewModel.RconPort.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.RconPort.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.RconPort.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.AcceptsTransfers.Title}"
                                            Description="{x:Bind ViewModel.AcceptsTransfers.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.AcceptsTransfers.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.AcceptsTransfers.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.NetworkCompressionThreshold.Title}"
                                            Description="{x:Bind ViewModel.NetworkCompressionThreshold.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.NetworkCompressionThreshold.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.NetworkCompressionThreshold.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.RateLimit.Title}"
                                            Description="{x:Bind ViewModel.RateLimit.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.RateLimit.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.RateLimit.Title}" />
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                                <settings:SettingsExpander
                                    Header="{x:Bind ViewModel.Text('desktop.config-gameplay')}">
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.Gamemode.Title}"
                                            Description="{x:Bind ViewModel.Gamemode.Description}">
                                            <ComboBox
                                                ItemsSource="{x:Bind ViewModel.Gamemode.Choices}"
                                                DisplayMemberPath="Label"
                                                SelectedValuePath="Value"
                                                SelectedValue="{x:Bind ViewModel.Gamemode.Value, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.Gamemode.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.Difficulty.Title}"
                                            Description="{x:Bind ViewModel.Difficulty.Description}">
                                            <ComboBox
                                                ItemsSource="{x:Bind ViewModel.Difficulty.Choices}"
                                                DisplayMemberPath="Label"
                                                SelectedValuePath="Value"
                                                SelectedValue="{x:Bind ViewModel.Difficulty.Value, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.Difficulty.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.MaxPlayers.Title}"
                                            Description="{x:Bind ViewModel.MaxPlayers.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.MaxPlayers.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.MaxPlayers.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.Pvp.Title}"
                                            Description="{x:Bind ViewModel.Pvp.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.Pvp.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.Pvp.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.AllowFlight.Title}"
                                            Description="{x:Bind ViewModel.AllowFlight.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.AllowFlight.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.AllowFlight.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.ForceGamemode.Title}"
                                            Description="{x:Bind ViewModel.ForceGamemode.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.ForceGamemode.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.ForceGamemode.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.Hardcore.Title}"
                                            Description="{x:Bind ViewModel.Hardcore.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.Hardcore.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.Hardcore.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.PlayerIdleTimeout.Title}"
                                            Description="{x:Bind ViewModel.PlayerIdleTimeout.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.PlayerIdleTimeout.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.PlayerIdleTimeout.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.SpawnMonsters.Title}"
                                            Description="{x:Bind ViewModel.SpawnMonsters.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.SpawnMonsters.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.SpawnMonsters.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.ResourcePack.Title}"
                                            Description="{x:Bind ViewModel.ResourcePack.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.ResourcePack.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.ResourcePack.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.RequireResourcePack.Title}"
                                            Description="{x:Bind ViewModel.RequireResourcePack.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.RequireResourcePack.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.RequireResourcePack.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.ResourcePackId.Title}"
                                            Description="{x:Bind ViewModel.ResourcePackId.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.ResourcePackId.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.ResourcePackId.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.ResourcePackPrompt.Title}"
                                            Description="{x:Bind ViewModel.ResourcePackPrompt.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.ResourcePackPrompt.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.ResourcePackPrompt.Title}" />
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                                <settings:SettingsExpander
                                    Header="{x:Bind ViewModel.Text('desktop.config-world')}">
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.LevelName.Title}"
                                            Description="{x:Bind ViewModel.LevelName.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.LevelName.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.LevelName.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.LevelSeed.Title}"
                                            Description="{x:Bind ViewModel.LevelSeed.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.LevelSeed.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.LevelSeed.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.LevelType.Title}"
                                            Description="{x:Bind ViewModel.LevelType.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.LevelType.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.LevelType.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.GeneratorSettings.Title}"
                                            Description="{x:Bind ViewModel.GeneratorSettings.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.GeneratorSettings.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.GeneratorSettings.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.AllowNether.Title}"
                                            Description="{x:Bind ViewModel.AllowNether.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.AllowNether.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.AllowNether.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.GenerateStructures.Title}"
                                            Description="{x:Bind ViewModel.GenerateStructures.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.GenerateStructures.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.GenerateStructures.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.MaxWorldSize.Title}"
                                            Description="{x:Bind ViewModel.MaxWorldSize.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.MaxWorldSize.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.MaxWorldSize.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.InitialEnabledPacks.Title}"
                                            Description="{x:Bind ViewModel.InitialEnabledPacks.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.InitialEnabledPacks.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.InitialEnabledPacks.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.InitialDisabledPacks.Title}"
                                            Description="{x:Bind ViewModel.InitialDisabledPacks.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.InitialDisabledPacks.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.InitialDisabledPacks.Title}" />
                                        </settings:SettingsCard>
                                    </settings:SettingsExpander.Items>
                                </settings:SettingsExpander>
                                <settings:SettingsExpander
                                    Header="{x:Bind ViewModel.Text('desktop.config-security')}">
                                    <settings:SettingsExpander.Items>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.OnlineMode.Title}"
                                            Description="{x:Bind ViewModel.OnlineMode.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.OnlineMode.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.OnlineMode.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.WhiteList.Title}"
                                            Description="{x:Bind ViewModel.WhiteList.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.WhiteList.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.WhiteList.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.EnforceWhitelist.Title}"
                                            Description="{x:Bind ViewModel.EnforceWhitelist.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.EnforceWhitelist.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.EnforceWhitelist.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.EnforceSecureProfile.Title}"
                                            Description="{x:Bind ViewModel.EnforceSecureProfile.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.EnforceSecureProfile.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.EnforceSecureProfile.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.PreventProxyConnections.Title}"
                                            Description="{x:Bind ViewModel.PreventProxyConnections.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.PreventProxyConnections.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.PreventProxyConnections.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.HideOnlinePlayers.Title}"
                                            Description="{x:Bind ViewModel.HideOnlinePlayers.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.HideOnlinePlayers.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.HideOnlinePlayers.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.LogIps.Title}"
                                            Description="{x:Bind ViewModel.LogIps.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.LogIps.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.LogIps.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.EnableCommandBlock.Title}"
                                            Description="{x:Bind ViewModel.EnableCommandBlock.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.EnableCommandBlock.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.EnableCommandBlock.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.BroadcastConsoleToOps.Title}"
                                            Description="{x:Bind ViewModel.BroadcastConsoleToOps.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.BroadcastConsoleToOps.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.BroadcastConsoleToOps.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.BroadcastRconToOps.Title}"
                                            Description="{x:Bind ViewModel.BroadcastRconToOps.Description}">
                                            <ToggleSwitch
                                                IsOn="{x:Bind ViewModel.BroadcastRconToOps.IsOn, Mode=TwoWay}"
                                                AutomationProperties.Name="{x:Bind ViewModel.BroadcastRconToOps.Title}" />
                                        </settings:SettingsCard>
                                        <settings:SettingsCard
                                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                                            Header="{x:Bind ViewModel.OpPermissionLevel.Title}"
                                            Description="{x:Bind ViewModel.OpPermissionLevel.Description}">
                                            <TextBox
                                                Text="{x:Bind ViewModel.OpPermissionLevel.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                AutomationProperties.Name="{x:Bind ViewModel.OpPermissionLevel.Title}" />
