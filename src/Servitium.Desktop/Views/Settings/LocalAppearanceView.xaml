<UserControl
    x:Class="Servitium.Desktop.Views.Settings.LocalAppearanceView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls">
    <StackPanel
        Spacing="{ThemeResource SelectorBarItemSpacing}">
        <settings:SettingsCard
            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
            Header="{x:Bind ViewModel.Text('settings.theme')}">
            <ComboBox
                SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}"
                AutomationProperties.AutomationId="preferences:theme">
                <ComboBoxItem
                    Content="{x:Bind ViewModel.Text('theme.system')}" />
                <ComboBoxItem
                    Content="{x:Bind ViewModel.Text('theme.light')}" />
                <ComboBoxItem
                    Content="{x:Bind ViewModel.Text('theme.dark')}" />
            </ComboBox>
        </settings:SettingsCard>
        <settings:SettingsCard
            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
            Header="{x:Bind ViewModel.Text('field.language')}"
            Description="{x:Bind ViewModel.Text('desktop.local-language-help')}">
            <ComboBox
                SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}"
                AutomationProperties.AutomationId="preferences:language">
                <ComboBoxItem
                    Content="{x:Bind ViewModel.Text('desktop.choice-zh-Hans')}" />
                <ComboBoxItem
                    Content="{x:Bind ViewModel.Text('desktop.choice-en-US')}" />
            </ComboBox>
        </settings:SettingsCard>
    </StackPanel>
</UserControl>
