<UserControl
    x:Class="Servitium.Desktop.Views.Settings.AccountSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="{x:Bind ViewModel.Severity, Mode=OneWay}" />
        </StackPanel>
        <CommandBar
            Grid.Row="1"
            DefaultLabelPosition="Right"
            HorizontalAlignment="Left">
            <AppBarButton
                Label="{x:Bind ViewModel.Text('action.refresh')}"
                Icon="Refresh"
                Command="{x:Bind ViewModel.RefreshCommand}" />
            <AppBarButton
                Label="{x:Bind ViewModel.Text('desktop.settings-more')}"
                Icon="More">
                <AppBarButton.Flyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Text="{x:Bind ViewModel.Text('action.sign-out')}"
                            Command="{x:Bind ViewModel.SignOutCommand}" />
                    </MenuFlyout>
                </AppBarButton.Flyout>
            </AppBarButton>
        </CommandBar>
        <ScrollViewer
            Grid.Row="2"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                Spacing="{ThemeResource SelectorBarItemSpacing}">
                <settings:SettingsCard
                    Header="{x:Bind ViewModel.Text('desktop.account-profile')}"
                    Description="{x:Bind ViewModel.UserName, Mode=OneWay}"
                    ContentAlignment="Vertical"
                    HorizontalContentAlignment="Stretch"
                    IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                    <StackPanel>
                        <TextBox
                            Header="{x:Bind ViewModel.Text('field.display-name')}"
                            Text="{x:Bind ViewModel.DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.AutomationId="account:display-name" />
                        <ComboBox
                            Header="{x:Bind ViewModel.Text('field.language')}"
                            SelectedIndex="{x:Bind ViewModel.LanguageIndex, Mode=TwoWay}">
                            <ComboBoxItem
                                Content="{x:Bind ViewModel.Text('desktop.choice-zh-Hans')}" />
                            <ComboBoxItem
                                Content="{x:Bind ViewModel.Text('desktop.choice-en-US')}" />
                        </ComboBox>
                        <Button
                            Content="{x:Bind ViewModel.Text('action.save')}"
                            Command="{x:Bind ViewModel.SaveProfileCommand}"
                            AutomationProperties.AutomationId="account:save-profile" />
                    </StackPanel>
                </settings:SettingsCard>
                <settings:SettingsExpander
                    Header="{x:Bind ViewModel.Text('action.change-password')}">
                    <settings:SettingsExpander.Items>
                        <settings:SettingsCard
                            Header="{x:Bind ViewModel.Text('desktop.account-password-help')}"
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch"
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}">
                            <StackPanel>
                                <PasswordBox
                                    Header="{x:Bind ViewModel.Text('field.current-password')}"
                                    Password="{x:Bind ViewModel.CurrentPassword, Mode=TwoWay}" />
                                <PasswordBox
                                    Header="{x:Bind ViewModel.Text('field.new-password')}"
                                    Password="{x:Bind ViewModel.NewPassword, Mode=TwoWay}" />
                                <PasswordBox
                                    Header="{x:Bind ViewModel.Text('field.confirm-password')}"
                                    Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay}" />
                                <Button
                                    Content="{x:Bind ViewModel.Text('action.change-password')}"
                                    Command="{x:Bind ViewModel.ChangePasswordCommand}" />
                            </StackPanel>
                        </settings:SettingsCard>
                    </settings:SettingsExpander.Items>
                </settings:SettingsExpander>
                <settings:SettingsExpander
                    Header="{x:Bind ViewModel.Text('desktop.account-totp')}"
                    Description="{x:Bind ViewModel.TotpStatus, Mode=OneWay}">
                    <settings:SettingsExpander.Items>
                        <settings:SettingsCard
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            Header="{x:Bind ViewModel.Text('desktop.account-totp-help')}"
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <Button
                                    Content="{x:Bind ViewModel.Text('action.configure-totp')}"
                                    Command="{x:Bind ViewModel.BeginTotpCommand}" />
                                <StackPanel
                                    Visibility="{x:Bind ViewModel.IsEnrolling, Mode=OneWay}">
                                    <TextBlock
                                        Text="{x:Bind ViewModel.TotpMaterial, Mode=OneWay}"
                                        TextWrapping="Wrap"
                                        IsTextSelectionEnabled="True" />
                                    <TextBox
                                        Header="{x:Bind ViewModel.Text('field.code')}"
                                        Text="{x:Bind ViewModel.TotpCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <Button
                                        Content="{x:Bind ViewModel.Text('common.confirm')}"
                                        Command="{x:Bind ViewModel.ConfirmTotpCommand}" />
                                    <Button
                                        Content="{x:Bind ViewModel.Text('common.cancel')}"
                                        Command="{x:Bind ViewModel.CancelTotpCommand}" />
                                </StackPanel>
                                <Button
                                    Content="{x:Bind ViewModel.Text('desktop.settings-more')}">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="{x:Bind ViewModel.Text('action.remove-totp')}"
                                                Command="{x:Bind ViewModel.RemoveTotpCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </settings:SettingsCard>
                    </settings:SettingsExpander.Items>
                </settings:SettingsExpander>
                <settings:SettingsExpander
                    Header="{x:Bind ViewModel.Text('desktop.account-oidc')}"
                    Description="{x:Bind ViewModel.ExternalStatus, Mode=OneWay}">
                    <settings:SettingsExpander.Items>
                        <settings:SettingsCard
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            Header="{x:Bind ViewModel.Text('desktop.account-oidc-help')}"
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <Button
                                    Content="{x:Bind ViewModel.Text('action.bind-oidc')}"
                                    Command="{x:Bind ViewModel.BindOidcCommand}" />
                                <Button
                                    Content="{x:Bind ViewModel.Text('desktop.settings-more')}">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="{x:Bind ViewModel.Text('action.unbind-oidc')}"
                                                Command="{x:Bind ViewModel.UnbindOidcCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </settings:SettingsCard>
                    </settings:SettingsExpander.Items>
                </settings:SettingsExpander>
                <settings:SettingsExpander
                    Header="{x:Bind ViewModel.Text('desktop.account-keys')}">
                    <settings:SettingsExpander.Items>
                        <settings:SettingsCard
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            Header="{x:Bind ViewModel.Text('desktop.account-keys-help')}"
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock
                                    Text="{x:Bind ViewModel.Text('desktop.account-keys-empty')}"
                                    Visibility="{x:Bind ViewModel.KeysEmpty, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <ListView
                                    ItemsSource="{x:Bind ViewModel.ApiKeys}"
                                    SelectedItem="{x:Bind ViewModel.SelectedKey, Mode=TwoWay}" />
                                <Button
                                    Content="{x:Bind ViewModel.Text('action.create-api-key')}"
                                    Command="{x:Bind ViewModel.CreateKeyCommand}" />
                                <Button
                                    Content="{x:Bind ViewModel.Text('desktop.settings-more')}">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="{x:Bind ViewModel.Text('action.revoke-api-key')}"
                                                Command="{x:Bind ViewModel.RevokeKeyCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </settings:SettingsCard>
                    </settings:SettingsExpander.Items>
                </settings:SettingsExpander>
                <settings:SettingsExpander
                    Header="{x:Bind ViewModel.Text('desktop.account-sessions')}">
                    <settings:SettingsExpander.Items>
                        <settings:SettingsCard
                            IsEnabled="{x:Bind ViewModel.CanEdit, Mode=OneWay}"
                            Header="{x:Bind ViewModel.Text('desktop.account-sessions-help')}"
                            ContentAlignment="Vertical"
                            HorizontalContentAlignment="Stretch">
                            <StackPanel>
                                <TextBlock
                                    Text="{x:Bind ViewModel.Text('desktop.account-sessions-empty')}"
                                    Visibility="{x:Bind ViewModel.SessionsEmpty, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <ListView
                                    ItemsSource="{x:Bind ViewModel.Sessions}"
                                    SelectedItem="{x:Bind ViewModel.SelectedSession, Mode=TwoWay}" />
                                <Button
                                    Content="{x:Bind ViewModel.Text('desktop.settings-more')}">
                                    <Button.Flyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem
                                                Text="{x:Bind ViewModel.Text('action.revoke-session')}"
                                                Command="{x:Bind ViewModel.RevokeSessionCommand}" />
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </settings:SettingsCard>
                    </settings:SettingsExpander.Items>
                </settings:SettingsExpander>
                <TextBlock
                    Text="{x:Bind ViewModel.Text('desktop.settings-scope-account')}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
