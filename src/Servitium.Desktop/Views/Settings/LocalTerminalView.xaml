<UserControl
    x:Class="Servitium.Desktop.Views.Settings.LocalTerminalView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls">
    <StackPanel
        Spacing="{ThemeResource SelectorBarItemSpacing}">
        <settings:SettingsCard
            IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
            Header="{x:Bind ViewModel.Text('settings.terminal-font-size')}"
            Description="{x:Bind ViewModel.Text('desktop.local-terminal-help')}">
            <NumberBox
                Value="{x:Bind ViewModel.TerminalFontSize, Mode=TwoWay}"
                AutomationProperties.Name="{x:Bind ViewModel.Text('settings.terminal-font-size')}"
                AutomationProperties.AutomationId="preferences:terminal-font" />
        </settings:SettingsCard>
    </StackPanel>
</UserControl>
