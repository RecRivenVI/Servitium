<UserControl
    x:Class="Servitium.Desktop.Views.Settings.ConnectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:settings="using:CommunityToolkit.WinUI.Controls">
    <ScrollViewer
        HorizontalScrollBarVisibility="Disabled">
        <StackPanel
            Spacing="{ThemeResource SelectorBarItemSpacing}">
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="{x:Bind ViewModel.Severity, Mode=OneWay}" />
            <TextBlock
                Text="{x:Bind ViewModel.CurrentConnection, Mode=OneWay}"
                TextWrapping="Wrap" />
            <settings:SettingsCard
                Header="{x:Bind ViewModel.Text('desktop.settings-add-connection')}"
                Description="{x:Bind ViewModel.Text('desktop.settings-address-help')}"
                ContentAlignment="Vertical"
                HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBox
                        Text="{x:Bind ViewModel.Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.Name="{x:Bind ViewModel.Text('field.address')}"
                        AutomationProperties.AutomationId="connections:address" />
                    <Button
                        Content="{x:Bind ViewModel.Text('desktop.settings-connect')}"
                        Command="{x:Bind ViewModel.AddCommand}"
                        AutomationProperties.AutomationId="connections:add" />
                </StackPanel>
            </settings:SettingsCard>
            <settings:SettingsCard
                Header="{x:Bind ViewModel.Text('desktop.settings-saved-connections')}"
                ContentAlignment="Vertical"
                HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <ComboBox
                        ItemsSource="{x:Bind ViewModel.Profiles}"
                        DisplayMemberPath="Name"
                        SelectedItem="{x:Bind ViewModel.Selected, Mode=TwoWay}"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.Name="{x:Bind ViewModel.Text('desktop.settings-saved-connections')}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.SelectedAddress, Mode=OneWay}"
                        TextWrapping="Wrap"
                        IsTextSelectionEnabled="True" />
                    <TextBox
                        Header="{x:Bind ViewModel.Text('field.name')}"
                        Text="{x:Bind ViewModel.ProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="{ThemeResource SelectorBarItemSpacing}">
                        <Button
                            Content="{x:Bind ViewModel.Text('desktop.settings-connect')}"
                            Command="{x:Bind ViewModel.ConnectCommand}" />
                        <Button
                            Content="{x:Bind ViewModel.Text('action.rename')}"
                            Command="{x:Bind ViewModel.RenameCommand}" />
                        <Button
                            Content="{x:Bind ViewModel.Text('desktop.settings-more')}">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem
                                        Text="{x:Bind ViewModel.Text('desktop.settings-remove-connection')}"
                                        Command="{x:Bind ViewModel.DeleteCommand}" />
                                </MenuFlyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.Text('desktop.settings-delete-connection-help')}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </settings:SettingsCard>
            <settings:SettingsCard
                Header="{x:Bind ViewModel.Text('desktop.settings-remove-connection')}"
                Description="{x:Bind ViewModel.Text('desktop.settings-remove-connection-impact')}"
                Visibility="{x:Bind ViewModel.IsConfirmingDelete, Mode=OneWay}"
                ContentAlignment="Vertical"
                HorizontalContentAlignment="Stretch">
                <StackPanel>
                    <TextBlock
                        Text="{x:Bind ViewModel.PendingDelete.Name, Mode=OneWay}" />
                    <Button
                        Content="{x:Bind ViewModel.Text('common.confirm')}"
                        Command="{x:Bind ViewModel.ConfirmDeleteCommand}" />
                    <Button
                        Content="{x:Bind ViewModel.Text('common.cancel')}"
                        Command="{x:Bind ViewModel.CancelDeleteCommand}" />
                </StackPanel>
            </settings:SettingsCard>
            <TextBlock
                Text="{x:Bind ViewModel.Text('desktop.settings-scope-local')}"
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
