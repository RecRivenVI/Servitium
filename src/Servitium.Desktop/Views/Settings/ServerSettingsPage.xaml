<UserControl
    x:Class="Servitium.Desktop.Views.Settings.ServerSettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="S"
            Modifiers="Control"
            Invoked="OnSaveInvoked" />
    </UserControl.KeyboardAccelerators>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
            <RowDefinition
                Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <ProgressBar
                IsIndeterminate="True"
                Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                Severity="{x:Bind ViewModel.Severity, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.HasValidation, Mode=OneWay}"
                Message="{x:Bind ViewModel.Validation, Mode=OneWay}"
                Severity="Warning"
                IsClosable="False" />
        </StackPanel>
        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled">
            <StackPanel
                Spacing="{ThemeResource SelectorBarItemSpacing}">
                <ContentControl
                    x:Name="CategoryContent"
                    HorizontalContentAlignment="Stretch" />
                <TextBlock
                    Text="{x:Bind ViewModel.Text('desktop.settings-scope-server')}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="{ThemeResource SelectorBarItemSpacing}">
            <TextBlock
                Text="{x:Bind ViewModel.DirtyText, Mode=OneWay}"
                VerticalAlignment="Center" />
            <Button
                Content="{x:Bind ViewModel.Text('action.refresh')}"
                Command="{x:Bind ViewModel.RefreshCommand}"
                AutomationProperties.AutomationId="settings:refresh" />
            <Button
                Content="{x:Bind ViewModel.Text('action.discard')}"
                Command="{x:Bind ViewModel.DiscardCommand}" />
            <Button
                Content="{x:Bind ViewModel.Text('action.save')}"
                Command="{x:Bind ViewModel.SaveCommand}"
                Style="{ThemeResource AccentButtonStyle}"
                AutomationProperties.AutomationId="settings:save" />
        </StackPanel>
    </Grid>
</UserControl>
