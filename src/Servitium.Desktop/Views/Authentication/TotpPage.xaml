<Page
    x:Class="Servitium.Desktop.Views.Authentication.TotpPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.AutomationId="PG-003">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Enter"
            Invoked="OnSubmitInvoked" />
    </Page.KeyboardAccelerators>
    <Grid
        x:Name="LayoutRoot"
        SizeChanged="OnLayoutChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="LeadingSpace"
                Width="*" />
            <ColumnDefinition
                Width="2*" />
            <ColumnDefinition
                x:Name="TrailingSpace"
                Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer
            Grid.Column="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center">
            <StackPanel
                MaxWidth="{ThemeResource ContentDialogMaxWidth}"
                Padding="{ThemeResource ContentDialogPadding}"
                Spacing="{ThemeResource SelectorBarItemSpacing}">
                <TextBlock
                    Text="{x:Bind ViewModel.Text('auth.totp.title')}"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.Text('desktop.totp-intro')}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.Severity, Mode=OneWay}"
                    IsClosable="True" />
                <StackPanel
                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                    <TextBox
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        x:Name="UserNameBox"
                        Header="{x:Bind ViewModel.CodeLabel, Mode=OneWay}"
                        Text="{x:Bind ViewModel.Code, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.AutomationId="PG-003:field:code" />
                    <ToggleSwitch
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        Header="{x:Bind ViewModel.Text('desktop.use-recovery-code')}"
                        IsOn="{x:Bind ViewModel.UseRecoveryCode, Mode=TwoWay}"
                        AutomationProperties.AutomationId="PG-003:use-recovery-code" />
                </StackPanel>
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <Button
                    Content="{x:Bind ViewModel.Text('desktop.totp-submit')}"
                    Command="{x:Bind ViewModel.SubmitCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="PG-003:action:verify" />
                <HyperlinkButton
                    Content="{x:Bind ViewModel.Text('desktop.back-to-login')}"
                    Command="{x:Bind ViewModel.BackCommand}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
