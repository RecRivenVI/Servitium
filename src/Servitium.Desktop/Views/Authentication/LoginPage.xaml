<Page
    x:Class="Servitium.Desktop.Views.Authentication.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.AutomationId="PG-002">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Enter"
            Invoked="OnSubmitInvoked" />
    </Page.KeyboardAccelerators>
    <Grid
        x:Name="LayoutRoot"
        SizeChanged="OnLayoutChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="LeadingSpace"
                Width="*" />
            <ColumnDefinition
                Width="2*" />
            <ColumnDefinition
                x:Name="TrailingSpace"
                Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer
            Grid.Column="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center">
            <StackPanel
                MaxWidth="{ThemeResource ContentDialogMaxWidth}"
                Padding="{ThemeResource ContentDialogPadding}"
                Spacing="{ThemeResource SelectorBarItemSpacing}">
                <TextBlock
                    Text="{x:Bind ViewModel.Text('auth.login.title')}"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.Text('desktop.login-intro')}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.Severity, Mode=OneWay}"
                    IsClosable="True" />
                <StackPanel
                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                    <TextBlock
                        Text="{x:Bind ViewModel.LoginNote, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.HasLoginNote, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBox
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        x:Name="UserNameBox"
                        Header="{x:Bind ViewModel.Text('field.user-name')}"
                        Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.AutomationId="PG-002:field:user-name" />
                    <PasswordBox
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        Header="{x:Bind ViewModel.Text('field.password')}"
                        Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                        AutomationProperties.AutomationId="PG-002:field:password" />
                </StackPanel>
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <TextBlock
                    Text="{x:Bind ViewModel.RedirectNote, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsRedirecting, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <HyperlinkButton
                    Content="{x:Bind ViewModel.Text('common.cancel')}"
                    Command="{x:Bind ViewModel.CancelRedirectCommand}"
                    Visibility="{x:Bind ViewModel.IsRedirecting, Mode=OneWay}" />
                <Button
                    Content="{x:Bind ViewModel.Text('desktop.login-submit')}"
                    Command="{x:Bind ViewModel.SubmitCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="PG-002:action:sign-in" />
                <Button
                    Content="{x:Bind ViewModel.ExternalLabel, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ExternalEnabled, Mode=OneWay}"
                    Command="{x:Bind ViewModel.ExternalCommand}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="PG-002:action:external-sign-in" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
