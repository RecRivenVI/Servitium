<Page
    x:Class="Servitium.Desktop.Views.Authentication.SetupPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    HorizontalContentAlignment="Stretch"
    VerticalContentAlignment="Stretch"
    AutomationProperties.AutomationId="PG-001">
    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="Enter"
            Invoked="OnSubmitInvoked" />
    </Page.KeyboardAccelerators>
    <Grid
        x:Name="LayoutRoot"
        SizeChanged="OnLayoutChanged">
        <Grid.ColumnDefinitions>
            <ColumnDefinition
                x:Name="LeadingSpace"
                Width="*" />
            <ColumnDefinition
                Width="2*" />
            <ColumnDefinition
                x:Name="TrailingSpace"
                Width="*" />
        </Grid.ColumnDefinitions>
        <ScrollViewer
            Grid.Column="1"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Center">
            <StackPanel
                MaxWidth="{ThemeResource ContentDialogMaxWidth}"
                Padding="{ThemeResource ContentDialogPadding}"
                Spacing="{ThemeResource SelectorBarItemSpacing}">
                <TextBlock
                    Text="{x:Bind ViewModel.Text('auth.setup.title')}"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Text="{x:Bind ViewModel.Text('desktop.setup-intro')}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.HasMessage, Mode=OneWay}"
                    Message="{x:Bind ViewModel.Message, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.Severity, Mode=OneWay}"
                    IsClosable="True" />
                <StackPanel
                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                    <TextBox
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        x:Name="UserNameBox"
                        Header="{x:Bind ViewModel.Text('field.user-name')}"
                        Text="{x:Bind ViewModel.UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        AutomationProperties.AutomationId="PG-001:field:user-name" />
                    <PasswordBox
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        Header="{x:Bind ViewModel.Text('field.password')}"
                        Password="{x:Bind ViewModel.Password, Mode=TwoWay}"
                        AutomationProperties.AutomationId="PG-001:field:password" />
                    <PasswordBox
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        Header="{x:Bind ViewModel.Text('field.confirm-password')}"
                        Password="{x:Bind ViewModel.ConfirmPassword, Mode=TwoWay}"
                        AutomationProperties.AutomationId="PG-001:field:confirm-password" />
                    <ComboBox
                        IsEnabled="{x:Bind ViewModel.CanInteract, Mode=OneWay}"
                        Header="{x:Bind ViewModel.Text('field.language')}"
                        SelectedValue="{x:Bind ViewModel.Language, Mode=TwoWay}"
                        SelectedValuePath="Tag"
                        HorizontalAlignment="Stretch">
                        <ComboBoxItem
                            Content="{x:Bind ViewModel.Text('language.zh-hans')}"
                            Tag="zh-Hans" />
                        <ComboBoxItem
                            Content="{x:Bind ViewModel.Text('language.en-us')}"
                            Tag="en-US" />
                    </ComboBox>
                    <TextBlock
                        Text="{x:Bind ViewModel.ValidationMessage, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Style="{ThemeResource CaptionTextBlockStyle}" />
                </StackPanel>
                <ProgressRing
                    IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
                <Button
                    Content="{x:Bind ViewModel.Text('desktop.setup-submit')}"
                    Command="{x:Bind ViewModel.SubmitCommand}"
                    Style="{ThemeResource AccentButtonStyle}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="PG-001:action:complete-setup" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
