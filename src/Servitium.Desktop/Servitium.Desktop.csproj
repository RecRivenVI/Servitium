<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <RootNamespace>Servitium.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <EnableMsixTooling>false</EnableMsixTooling>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <ProjectReference Include="..\Servitium.Client\Servitium.Client.csproj" />
    <ProjectReference Include="..\Servitium.Contracts\Servitium.Contracts.csproj" />
  </ItemGroup>

  <Target Name="RestoreDesktopWebAssets" BeforeTargets="BuildDesktopWebAssets"
          Inputs="WebAssetsSource\package-lock.json"
          Outputs="WebAssetsSource\node_modules\.package-lock.json">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\WebAssetsSource"
          Command="npm ci --ignore-scripts --no-audit --no-fund" />
  </Target>

  <Target Name="BuildDesktopWebAssets" BeforeTargets="BeforeBuild"
          Inputs="WebAssetsSource\package-lock.json;WebAssetsSource\build-assets.mjs;@(DesktopWebAssetsSource)"
          Outputs="$(IntermediateOutputPath)WebAssets\.complete">
    <RemoveDir Directories="$(IntermediateOutputPath)WebAssets" />
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)\WebAssetsSource"
          Command="node build-assets.mjs &quot;$(IntermediateOutputPath)WebAssets&quot;" />
    <Touch Files="$(IntermediateOutputPath)WebAssets\.complete" AlwaysCreate="true" />
  </Target>

  <Target Name="CopyDesktopWebAssets" AfterTargets="BuildDesktopWebAssets;Build">
    <ItemGroup>
      <_DesktopWebAsset Include="$(IntermediateOutputPath)WebAssets\**\*" Exclude="$(IntermediateOutputPath)WebAssets\.complete" />
    </ItemGroup>
    <Copy SourceFiles="@(_DesktopWebAsset)"
          DestinationFiles="@(_DesktopWebAsset->'$(OutDir)WebAssets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <DesktopWebAssetsSource Include="WebAssetsSource\site\**\*" />
  </ItemGroup>
</Project>
