<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Servitium.Desktop.MainWindow">
    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition
                Height="Auto" />
            <RowDefinition
                Height="*" />
        </Grid.RowDefinitions>
        <TitleBar
            x:Name="AppTitleBar"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="{x:Bind ViewModel.ShowCompactSearch, Mode=OneWay}"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.Resources>
                <HorizontalAlignment
                    x:Key="TitleBarContentHorizontalAlignment">Stretch</HorizontalAlignment>
            </TitleBar.Resources>
            <TitleBar.LeftHeader>
                <DropDownButton
                    x:Name="ConnectionButton"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.HelpText="{x:Bind ViewModel.ConnectionAddress, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ConnectionAddress, Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind ViewModel.ConnectionTitle, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="shell:connection">
                    <DropDownButton.Content>
                        <StackPanel>
                            <TextBlock
                                Text="{x:Bind ViewModel.ConnectionTitle, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind ViewModel.ConnectionAddress, Mode=OneWay}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DropDownButton.Content>
                    <DropDownButton.Flyout>
                        <MenuFlyout
                            x:Name="ConnectionsMenu"
                            Opening="ConnectionsMenu_Opening" />
                    </DropDownButton.Flyout>
                </DropDownButton>
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="GlobalSearch"
                    PlaceholderText="{x:Bind ViewModel.SearchHint, Mode=OneWay}"
                    Visibility="{x:Bind ViewModel.ShowInlineSearch, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.IsAuthenticated, Mode=OneWay}"
                    QueryIcon="Find"
                    AutomationProperties.AutomationId="shell:search"
                    TextChanged="GlobalSearch_TextChanged"
                    QuerySubmitted="GlobalSearch_QuerySubmitted" />
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel
                    Orientation="Horizontal"
                    Spacing="{ThemeResource SelectorBarItemSpacing}">
                    <Button
                        x:Name="CompactSearchButton"
                        Visibility="{x:Bind ViewModel.ShowCompactSearch, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.SearchHint, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.SearchHint, Mode=OneWay}"
                        AutomationProperties.AutomationId="shell:compact-search">
                        <SymbolIcon
                            Symbol="Find" />
                        <Button.Flyout>
                            <Flyout
                                x:Name="CompactSearchFlyout"
                                Opened="CompactSearchFlyout_Opened">
                                <AutoSuggestBox
                                    x:Name="CompactSearch"
                                    QueryIcon="Find"
                                    MinWidth="{ThemeResource ContentDialogMinWidth}"
                                    PlaceholderText="{x:Bind ViewModel.SearchHint, Mode=OneWay}"
                                    AutomationProperties.AutomationId="shell:compact-search-input"
                                    TextChanged="GlobalSearch_TextChanged"
                                    QuerySubmitted="GlobalSearch_QuerySubmitted" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Name="OperationsButton"
                        Visibility="{x:Bind ViewModel.IsAuthenticated, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.IsAuthenticated, Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind ViewModel.OperationSummary, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.OperationSummary, Mode=OneWay}"
                        AutomationProperties.AutomationId="shell:operations"
                        Click="OperationsButton_Click">
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="{ThemeResource SelectorBarItemSpacing}">
                            <SymbolIcon
                                Symbol="Sync"
                                Visibility="{x:Bind ViewModel.ShowOperationSymbol, Mode=OneWay}" />
                            <InfoBadge
                                Value="{x:Bind ViewModel.OperationCount, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.IsCompact, Mode=OneWay}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.OperationSummary, Mode=OneWay}"
                                Visibility="{x:Bind ViewModel.ShowOperationSummary, Mode=OneWay}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>
        <NavigationView
            x:Name="Navigation"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="LeftCompact"
            IsPaneOpen="False"
            IsPaneToggleButtonVisible="{x:Bind ViewModel.ShowStandardNavigationToggle, Mode=OneWay}"
            SelectionChanged="Navigation_SelectionChanged"
            IsPaneVisible="{x:Bind ViewModel.IsAuthenticated, Mode=OneWay}"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch">
            <NavigationView.MenuItems>
                <NavigationViewItem
                    Content="{x:Bind ViewModel.InstancesText}"
                    Tag="instances"
                    AutomationProperties.AutomationId="navigation:instances">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{x:Bind ViewModel.NodesText}"
                    Tag="PG-020"
                    Visibility="{x:Bind ViewModel.ShowAdministration, Mode=OneWay}"
                    AutomationProperties.AutomationId="navigation:nodes">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{x:Bind ViewModel.DistributionText}"
                    Tag="PG-060"
                    Visibility="{x:Bind ViewModel.ShowAdministration, Mode=OneWay}"
                    AutomationProperties.AutomationId="navigation:distribution">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{x:Bind ViewModel.UsersText}"
                    Tag="PG-030"
                    Visibility="{x:Bind ViewModel.ShowUsers, Mode=OneWay}"
                    AutomationProperties.AutomationId="navigation:users">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    Content="{x:Bind ViewModel.ActivityText}"
                    Tag="PG-044"
                    AutomationProperties.AutomationId="navigation:activity">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem
                    Content="{x:Bind ViewModel.SettingsText}"
                    Tag="settings"
                    AutomationProperties.AutomationId="navigation:settings">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            Glyph="" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Grid
                x:Name="PageContentGrid">
                <Grid.RowDefinitions>
                    <RowDefinition
                        Height="Auto" />
                    <RowDefinition
                        Height="*" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <InfoBar
                        IsOpen="{x:Bind ViewModel.IsRealtimeDisconnected, Mode=OneWay}"
                        Message="{x:Bind ViewModel.RealtimeNotice, Mode=OneWay}"
                        Severity="Warning"
                        IsClosable="False" />
                    <InfoBar
                        x:Name="ShellStatus"
                        IsOpen="False"
                        IsClosable="True"
                        Margin="{ThemeResource TextControlThemePadding}" />
                </StackPanel>
                <ContentPresenter
                    x:Name="PageHost"
                    Grid.Row="1"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch" />
            </Grid>
        </NavigationView>
    </Grid>
</Window>
