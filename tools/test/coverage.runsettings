<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Exclude>[*.Tests]*,[*IntegrationTests]*,[*ContractTests]*,[Servitium.JavaServerFixture]*</Exclude>
          <ExcludeByFile>**/Program.cs,**/Migrations/**,**/Interop/**,**/obj/**</ExcludeByFile>
          <SingleHit>true</SingleHit>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
