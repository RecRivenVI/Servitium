<Project>
  <Import Project="$(MSBuildThisFileDirectory)tools/build/Local.props" Condition="Exists('$(MSBuildThisFileDirectory)tools/build/Local.props')" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902</WarningsNotAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <BaseOutputPath Condition="'$(ServitiumArtifactsRoot)' != ''">$(ServitiumArtifactsRoot)\Build\bin\$(MSBuildProjectName)\</BaseOutputPath>
    <BaseIntermediateOutputPath Condition="'$(ServitiumArtifactsRoot)' != ''">$(ServitiumArtifactsRoot)\Build\obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
    <Product>Servitium</Product>
    <VersionPrefix>0.1.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <InformationalVersion>$(VersionPrefix)-$(VersionSuffix)+local.0</InformationalVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <Target Name="ConfigureTestDocumentation" BeforeTargets="PrepareForBuild" Condition="'$(IsTestProject)' == 'true'">
    <PropertyGroup>
      <GenerateDocumentationFile>false</GenerateDocumentationFile>
      <DocumentationFile></DocumentationFile>
      <NoWarn>$(NoWarn);CS1591</NoWarn>
    </PropertyGroup>
  </Target>
  <Target Name="ConfigureTestInputs" BeforeTargets="AssignTargetPaths;GetAssemblyAttributes" Condition="'$(IsTestProject)' == 'true'">
    <ItemGroup>
      <AssemblyMetadata Include="RepositoryRoot" Value="$(RepositoryRoot)" />
      <Content Include="$(ServitiumArtifactsRoot)\Build\Fixtures\Servitium.JavaServerFixture.jar" Link="Servitium.JavaServerFixture.jar" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(ServitiumArtifactsRoot)\Build\Fixtures\Servitium.JavaServerFixture.jar')" />
    </ItemGroup>
  </Target>
</Project>
